  "requiredFonts": {
    "Material Symbols Rounded": "ttf-material-symbols-variable",
    "Material Symbols Sharp": "ttf-material-symbols-variable",
    "JetBrainsMono Nerd Font": "ttf-jetbrains-mono-nerd-basic",
    "Noto Sans CJK JP": "noto-fonts-cjk",
