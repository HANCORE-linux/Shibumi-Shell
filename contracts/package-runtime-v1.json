{
  "schemaVersion": 1,
  "packageName": "shibumi-shell",
  "requiredPackages": [
    "omarchy",
    "quickshell",
    "python",
    "jq",
    "curl",
    "networkmanager",
    "power-profiles-daemon",
    "upower",
    "xdg-utils",
    "libnotify",
    "wl-clipboard",
    "ttf-material-symbols-variable",
    "ttf-jetbrains-mono-nerd-basic",
    "noto-fonts-cjk",
    "adwaita-fonts"
  ],
  "requiredCommands": {
    "python3": "python",
    "jq": "jq",
    "curl": "curl",
    "nmcli": "networkmanager",
    "powerprofilesctl": "power-profiles-daemon",
    "upower": "upower",
    "xdg-open": "xdg-utils",
    "notify-send": "libnotify",
    "wl-copy": "wl-clipboard"
