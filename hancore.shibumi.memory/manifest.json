{
  "schemaVersion": 1,
  "id": "hancore.shibumi.memory",
  "name": "Shibumi Memory",
  "version": "0.1.1-beta.8",
  "author": "HANCORE",
  "license": "MIT",
  "description": "Shibumi memory widget and detailed memory panel.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Shibumi memory",
    "description": "Memory usage with compact and detailed views",
    "category": "System",
    "defaultSection": "left",
    "allowMultiple": false
  },
  "x-shibumi": {
    "suiteId": "hancore.shibumi",
    "bundle": "default",
    "role": "G4",
    "requires": [
      "hancore.shibumi.telemetry"
    ],
    "recommends": []
  }
}
