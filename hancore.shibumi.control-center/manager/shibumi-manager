#!/usr/bin/env python3
"""Persistent, dependency-free Shibumi/Omarchy continuity manager."""

from __future__ import annotations

import argparse
import copy
import fcntl
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any


REGIONS = ("left", "center", "right")
SUITE_ID = "hancore.shibumi"


class ManagerError(RuntimeError):
    pass


def discover_omarchy_root(
    home: Path, system_root: Path = Path("/usr/share/omarchy")
) -> Path:
    override = os.environ.get("OMARCHY_PATH")
    candidates = [
        Path(override) if override else None,
        system_root,
        home / ".local/share/omarchy",
    ]
    for candidate in candidates:
        if candidate and (candidate / "config/omarchy/shell.json").is_file():
            return candidate
    if override:
        return Path(override)
    return home / ".local/share/omarchy"


def paths() -> dict[str, Path]:
    home = Path.home()
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", home / ".config"))
    state_home = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state"))
    runtime_home = Path(
        os.environ.get("XDG_RUNTIME_DIR", f"/tmp/shibumi-{os.getuid()}")
    )
    omarchy_root = discover_omarchy_root(home)
    default_override = os.environ.get("SHIBUMI_DEFAULT_CONFIG")
    return {
        "config": Path(
            os.environ.get(
                "SHIBUMI_CONFIG_FILE", config_home / "omarchy/shell.json"
            )
        ),
        "defaults": Path(default_override)
        if default_override
        else omarchy_root / "config/omarchy/shell.json",
        "state": Path(
            os.environ.get("SHIBUMI_STATE_DIR", state_home / "shibumi")
        ),
        "lock": Path(
            os.environ.get(
                "SHIBUMI_LOCK_FILE", runtime_home / "shibumi-suite.lock"
            )
        ),
        "omarchy_root": omarchy_root,
        "shell": omarchy_root / "bin/omarchy-shell",
        "restart_shell": omarchy_root / "bin/omarchy-restart-shell",
    }


def decode_json(payload: bytes, label: str) -> dict[str, Any]:
    try:
        value = json.loads(payload.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ManagerError(f"cannot read {label}: {error}") from error
    if not isinstance(value, dict):
        raise ManagerError(f"{label} must be a JSON object")
    return value


def read_json(path: Path, label: str) -> dict[str, Any]:
    try:
        payload = path.read_bytes()
    except OSError as error:
        raise ManagerError(f"cannot read {label}: {error}") from error
    return decode_json(payload, label)


def atomic_write(path: Path, payload: bytes) -> None:
    durable_mkdir(path.parent)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
        fsync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def encode(value: dict[str, Any]) -> bytes:
    return (json.dumps(value, indent=2, sort_keys=True) + "\n").encode("utf-8")


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def durable_mkdir(path: Path) -> None:
    missing: list[Path] = []
    current = path
    while not current.exists():
        missing.append(current)
        if current.parent == current:
            raise ManagerError(f"cannot create manager directory: {path}")
        current = current.parent
    if not current.is_dir():
        raise ManagerError(f"manager parent is not a directory: {current}")
    for directory in reversed(missing):
        directory.mkdir()
        fsync_directory(directory)
        fsync_directory(directory.parent)


def durable_unlink(path: Path) -> None:
    existed = path.exists() or path.is_symlink()
    path.unlink(missing_ok=True)
    if existed and path.parent.is_dir():
        fsync_directory(path.parent)


def switch_preparation_path(runtime_paths: dict[str, Path]) -> Path:
    return runtime_paths["state"] / ".switch-transaction.preparing"


def switch_cleanup_path(runtime_paths: dict[str, Path]) -> Path:
    return runtime_paths["state"] / ".switch-transaction.cleanup"


def discard_private_switch_transactions(runtime_paths: dict[str, Path]) -> bool:
    removed = False
    for private in (
        switch_preparation_path(runtime_paths),
        switch_cleanup_path(runtime_paths),
    ):
        if not (private.exists() or private.is_symlink()):
            continue
        if private.is_symlink() or not private.is_dir():
            raise ManagerError(
                f"refusing malformed private switch transaction: {private}"
            )
        shutil.rmtree(private)
        removed = True
    if removed:
        fsync_directory(runtime_paths["state"])
    return removed


def retire_switch_transaction(
    runtime_paths: dict[str, Path], transaction: Path
) -> None:
    cleanup = switch_cleanup_path(runtime_paths)
    if cleanup.exists() or cleanup.is_symlink():
        raise ManagerError(f"switch cleanup path already exists: {cleanup}")
    os.replace(transaction, cleanup)
    fsync_directory(transaction.parent)
    shutil.rmtree(cleanup)
    fsync_directory(transaction.parent)


def prepare_switch_transaction(
    runtime_paths: dict[str, Path],
    target: str,
    config_path: Path,
    state_path: Path,
    config_existed: bool,
) -> tuple[Path, Path, Path, dict[str, Any], Path]:
    transaction = runtime_paths["state"] / "switch-transaction"
    preparation = switch_preparation_path(runtime_paths)
    if transaction.exists() or transaction.is_symlink():
        raise ManagerError(
            "an unfinished shell switch exists; run recover before retrying"
        )
    if preparation.exists() or preparation.is_symlink():
        raise ManagerError(
            "an unfinished switch preparation exists; run recover before retrying"
        )
    preparation.mkdir(parents=True, exist_ok=False)
    snapshot = preparation / "shell.json.before"
    state_snapshot = preparation / "install.json.before"
    journal = {
        "schemaVersion": 1,
        "target": target,
        "configExisted": config_existed,
        "phase": "prepared",
    }
    journal_path = preparation / "journal.json"
    try:
        if config_existed:
            atomic_write(snapshot, config_path.read_bytes())
        atomic_write(state_snapshot, state_path.read_bytes())
        atomic_write(journal_path, encode(journal))
        fsync_directory(preparation)
        os.replace(preparation, transaction)
        fsync_directory(transaction.parent)
    except Exception:
        # No live state changes precede publication. A complete directory that
        # crossed the atomic rename is retained for recovery; an unpublished
        # preparation is disposable and will also be removed after a crash.
        if preparation.exists() and not preparation.is_symlink():
            shutil.rmtree(preparation)
        raise
    return (
        transaction,
        transaction / snapshot.name,
        transaction / state_snapshot.name,
        journal,
        transaction / journal_path.name,
    )


def entry_id(value: Any) -> str:
    if isinstance(value, str):
        return value
    if isinstance(value, dict):
        return str(value.get("id") or "")
    return ""


def normalize(config: dict[str, Any]) -> dict[str, Any]:
    result = copy.deepcopy(config)
    result["version"] = 1
    if not isinstance(result.get("bar"), dict):
        result["bar"] = {}
    bar = result["bar"]
    if not isinstance(bar.get("layout"), dict):
        bar["layout"] = {}
    for region in REGIONS:
        if not isinstance(bar["layout"].get(region), list):
            bar["layout"][region] = []
    if not isinstance(result.get("plugins"), list):
        result["plugins"] = []
    return result


def copy_layout(layout: Any) -> dict[str, list[Any]]:
    source = layout if isinstance(layout, dict) else {}
    return {
        region: copy.deepcopy(source.get(region))
        if isinstance(source.get(region), list)
        else []
        for region in REGIONS
    }


def profile_path(runtime_paths: dict[str, Path]) -> Path:
    return runtime_paths["state"] / "shell-layout-profiles.json"


def load_layout_profiles(runtime_paths: dict[str, Path]) -> dict[str, Any]:
    path = profile_path(runtime_paths)
    if not path.is_file():
        return {"schemaVersion": 1, "layouts": {}, "centerAnchors": {}}
    value = read_json(path, "shell layout profiles")
    layouts = value.get("layouts")
    if value.get("schemaVersion") != 1 or not isinstance(layouts, dict):
        raise ManagerError("shell layout profiles are malformed")
    result: dict[str, Any] = {
        "schemaVersion": 1,
        "layouts": {},
        "centerAnchors": {},
    }
    center_anchors = value.get("centerAnchors", {})
    if not isinstance(center_anchors, dict):
        raise ManagerError("shell layout profile center anchors are malformed")
    for shell_id in ("shibumi", "omarchy"):
        if shell_id in layouts:
            result["layouts"][shell_id] = copy_layout(layouts[shell_id])
        anchor = center_anchors.get(shell_id)
        if isinstance(anchor, str):
            result["centerAnchors"][shell_id] = anchor
    return result


def initial_layout(
    target: str, defaults: dict[str, Any], state: dict[str, Any]
) -> dict[str, list[Any]]:
    if target == "shibumi":
        return {
            region: [
                {"id": plugin_id}
                for plugin_id in state["activation"]["layout"][region]
            ]
            for region in REGIONS
        }
    previous_bar = state.get("previousBar")
    if isinstance(previous_bar, dict):
        previous_layout = previous_bar.get("layout")
        if isinstance(previous_layout, dict) and all(
            isinstance(previous_layout.get(region), list) for region in REGIONS
        ):
            return copy_layout(previous_layout)
    return copy_layout(defaults.get("bar", {}).get("layout", {}))


def initial_center_anchor(
    target: str, defaults: dict[str, Any], state: dict[str, Any]
) -> str:
    if target == "shibumi":
        return "hancore.shibumi.center"
    previous_bar = state.get("previousBar")
    if isinstance(previous_bar, dict):
        previous_anchor = previous_bar.get("centerAnchor")
        return previous_anchor if isinstance(previous_anchor, str) else ""
    default_bar = defaults.get("bar")
    return (
        str(default_bar.get("centerAnchor") or "")
        if isinstance(default_bar, dict)
        else ""
    )


def snapshot_layout(
    config: dict[str, Any],
    shell_id: str,
    state: dict[str, Any],
    *,
    legacy: bool,
    trusted_layout: dict[str, list[Any]] | None = None,
) -> dict[str, list[Any]]:
    layout = copy_layout(config["bar"]["layout"])
    if shell_id != "shibumi":
        return layout

    trusted_omarchy: dict[str, int] = {}
    if not legacy and trusted_layout is not None:
        for region in REGIONS:
            for entry in trusted_layout[region]:
                plugin_id = entry_id(entry)
                if plugin_id.startswith("omarchy."):
                    trusted_omarchy[plugin_id] = (
                        trusted_omarchy.get(plugin_id, 0) + 1
                    )

    # Pre-profile continuity builds and the suite CLI could merge the complete
    # stock layout into Shibumi as "extras". Keep user/third-party widgets and
    # only those Omarchy widgets already recorded in the trusted Shibumi profile.
    snapshot: dict[str, list[Any]] = {region: [] for region in REGIONS}
    for region in REGIONS:
        for entry in layout[region]:
            plugin_id = entry_id(entry)
            if plugin_id.startswith("omarchy."):
                remaining = trusted_omarchy.get(plugin_id, 0)
                if remaining <= 0:
                    continue
                trusted_omarchy[plugin_id] = remaining - 1
            snapshot[region].append(entry)
    return snapshot


def validate_state(
    state: dict[str, Any], label: str = "install state"
) -> dict[str, Any]:
    activation = state.get("activation")
    if (
        state.get("suiteId") != SUITE_ID
        or not isinstance(state.get("plugins"), list)
        or not isinstance(activation, dict)
        or not isinstance(activation.get("layout"), dict)
        or not isinstance(activation.get("enableServices"), list)
    ):
        raise ManagerError(
            f"{label} predates or violates the continuity contract"
        )
    for region in REGIONS:
        if not isinstance(activation["layout"].get(region), list):
            raise ManagerError(f"{label} activation layout is malformed")
    return state


def load_state(runtime_paths: dict[str, Path]) -> dict[str, Any]:
    state = read_json(runtime_paths["state"] / "install.json", "install state")
    return validate_state(state)


def current_config(runtime_paths: dict[str, Path]) -> dict[str, Any]:
    config_path = runtime_paths["config"]
    if config_path.is_symlink():
        raise ManagerError(f"refusing symlinked shell config: {config_path}")
    source = (
        config_path
        if config_path.is_file() and config_path.stat().st_size
        else runtime_paths["defaults"]
    )
    return normalize(read_json(source, "shell config"))


def activate_config(
    config: dict[str, Any],
    state: dict[str, Any],
    target_layout: dict[str, list[Any]] | None = None,
) -> dict[str, Any]:
    result = normalize(config)
    activation = state["activation"]
    managed_ids = set(state["plugins"])
    selected_layout = target_layout or {
        region: [{"id": plugin_id} for plugin_id in activation["layout"][region]]
        for region in REGIONS
    }
    result["bar"]["layout"] = copy_layout(selected_layout)

    service_ids = list(activation["enableServices"])
    existing_services = {
        entry_id(entry): copy.deepcopy(entry)
        for entry in result["plugins"]
        if entry_id(entry) in service_ids
    }
    extras = [
        copy.deepcopy(entry)
        for entry in result["plugins"]
        if entry_id(entry) not in managed_ids
    ]
    result["plugins"] = extras + [
        existing_services.get(plugin_id, {"id": plugin_id})
        for plugin_id in service_ids
    ]
    result["bar"]["id"] = str(activation["activeBar"])
    result["bar"]["centerAnchor"] = "hancore.shibumi.center"
    result["bar"]["style"] = "shibumi"
    return result


def deactivate_config(
    config: dict[str, Any],
    defaults: dict[str, Any],
    state: dict[str, Any],
    target_layout: dict[str, list[Any]] | None = None,
    target_center_anchor: str | None = None,
) -> dict[str, Any]:
    result = normalize(config)
    managed_ids = set(state["plugins"])
    activation = state["activation"]
    result["bar"]["layout"] = copy_layout(
        target_layout
        if target_layout is not None
        else defaults.get("bar", {}).get("layout", {})
    )
    # In the stock Omarchy bar the continuity entry is a quiet return anchor,
    # not Shibumi's primary left-side wordmark. Keep exactly one instance at
    # the far right; BarWidget renders its dedicated mark on the stock host.
    continuity_widget = "hancore.shibumi.control-center"
    for region in REGIONS:
        result["bar"]["layout"][region] = [
            entry
            for entry in result["bar"]["layout"][region]
            if entry_id(entry) != continuity_widget
        ]
    if not any(
        entry_id(entry) == continuity_widget
        for region in REGIONS
        for entry in result["bar"]["layout"][region]
    ):
        result["bar"]["layout"]["right"].append({"id": continuity_widget})
    existing_services = {
        entry_id(entry): copy.deepcopy(entry)
        for entry in result["plugins"]
        if entry_id(entry) in activation["enableServices"]
    }
    result["plugins"] = [
        copy.deepcopy(entry)
        for entry in result["plugins"]
        if entry_id(entry) not in managed_ids
    ] + [
        existing_services.get(plugin_id, {"id": plugin_id})
        for plugin_id in activation["enableServices"]
    ]
    if result["bar"].get("id") == activation["activeBar"]:
        result["bar"].pop("id", None)
    if result["bar"].get("centerAnchor") == "hancore.shibumi.center":
        default_bar = defaults.get("bar")
        anchor = (
            target_center_anchor
            if target_center_anchor is not None
            else (
                str(default_bar.get("centerAnchor") or "")
                if isinstance(default_bar, dict)
                else ""
            )
        )
        if anchor:
            result["bar"]["centerAnchor"] = anchor
        else:
            result["bar"].pop("centerAnchor", None)
    if result["bar"].get("style") == "shibumi":
        result["bar"].pop("style", None)
    return result


def apply_shibumi_variant(
    config: dict[str, Any], target: str
) -> dict[str, Any]:
    """Persist the remembered Shibumi return target transactionally."""
    if target not in {"v1", "v2"}:
        return config
    result = normalize(config)
    shibumi = result["bar"].get("shibumi")
    if not isinstance(shibumi, dict):
        shibumi = {}
        result["bar"]["shibumi"] = shibumi
    presentation = shibumi.get("presentation")
    if not isinstance(presentation, dict):
        presentation = {}
        shibumi["presentation"] = presentation
    v2_styles = {"full", "fit", "dock", "notch"}
    current_style = str(presentation.get("shellStyle") or "")
    if target == "v1":
        if current_style in v2_styles:
            presentation["v2ShellStyle"] = current_style
        presentation["shellStyle"] = "shibumi"
    else:
        remembered = (
            current_style
            if current_style in v2_styles
            else str(presentation.get("v2ShellStyle") or "")
        )
        if remembered not in v2_styles:
            remembered = "full"
        presentation["v2ShellStyle"] = remembered
        presentation["shellStyle"] = remembered
    return result


def shell_call(
    runtime_paths: dict[str, Path], arguments: list[str], *, check: bool = False
) -> subprocess.CompletedProcess[str]:
    shell = runtime_paths["shell"]
    if not shell.is_file():
        raise ManagerError(f"Omarchy shell command is missing: {shell}")
    try:
        result = subprocess.run(
            [str(shell), *arguments],
            check=False,
            capture_output=True,
            text=True,
            timeout=20,
            env=runtime_environment(runtime_paths),
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise ManagerError(f"cannot run Omarchy shell command: {error}") from error
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        raise ManagerError(detail or "Omarchy shell command failed")
    return result


def reload_shell(runtime_paths: dict[str, Path], timeout: float = 30) -> None:
    restart = runtime_paths.get("restart_shell")
    if restart is not None and restart.is_file():
        try:
            result = subprocess.run(
                [str(restart)],
                check=False,
                capture_output=True,
                text=True,
                timeout=timeout,
                env=runtime_environment(runtime_paths),
            )
        except (OSError, subprocess.SubprocessError) as error:
            raise ManagerError(f"cannot restart Omarchy shell: {error}") from error
        if result.returncode != 0:
            detail = (result.stderr or result.stdout).strip()
            raise ManagerError(detail or "Omarchy shell restart failed")
        return

    # Compatibility path for older Omarchy installations that predate the
    # dedicated restart command.
    deadline = time.monotonic() + timeout
    detail = "shell did not answer"
    while time.monotonic() < deadline:
        result = shell_call(runtime_paths, ["shell", "reloadConfig"])
        response = result.stdout.strip()
        if result.returncode == 0 and response in ("", "ok"):
            return
        detail = (result.stderr or result.stdout).strip() or str(result.returncode)
        time.sleep(0.15)
    raise ManagerError(f"reload did not settle: {detail}")


def matching_shell_instances(
    runtime_paths: dict[str, Path], *, timeout: float = 6
) -> list[dict[str, Any]]:
    try:
        result = subprocess.run(
            ["quickshell", "list", "--all", "--json"],
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=runtime_environment(runtime_paths),
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise ManagerError(f"cannot inspect Quickshell registry: {error}") from error
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        raise ManagerError(
            "cannot inspect Quickshell registry"
            + (f": {detail}" if detail else f" (exit {result.returncode})")
        )
    if result.stdout == "No running instances.\n":
        values = []
    else:
        try:
            values = json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise ManagerError(
                "Quickshell registry returned malformed JSON"
            ) from error
    if not isinstance(values, list):
        raise ManagerError("Quickshell registry response is not an array")

    expected = (
        runtime_paths["omarchy_root"] / "shell" / "shell.qml"
    ).resolve(strict=False)
    matches: list[dict[str, Any]] = []
    for value in values:
        if not isinstance(value, dict):
            continue
        config_path = value.get("config_path")
        if not isinstance(config_path, str) or not config_path:
            continue
        if Path(config_path).resolve(strict=False) == expected:
            matches.append(value)
    return matches


def stop_shell(
    runtime_paths: dict[str, Path],
    timeout: float = 6,
    quiet_period: float = 0.1,
) -> None:
    if timeout <= 0:
        raise ManagerError("shell drain timeout must be positive")
    if quiet_period < 0:
        raise ManagerError("shell drain quiet period cannot be negative")
    shell_path = runtime_paths["omarchy_root"] / "shell"
    command = [
        "quickshell",
        "kill",
        "-p",
        str(shell_path),
        "--any-display",
    ]
    poll_interval = 0.05
    deadline = time.monotonic() + timeout
    evidence_deadline = deadline + 0.15
    final_snapshot_limit = 0.1
    empty_since: float | None = None
    snapshots: list[list[dict[str, Any]]] = []
    instances: list[dict[str, Any]] = []
    deadline_operation_error: str | None = None

    def evidence(values: list[dict[str, Any]]) -> list[dict[str, Any]]:
        return [
            {
                "id": str(value.get("id") or ""),
                "pid": value.get("pid"),
                "config_path": str(value.get("config_path") or ""),
            }
            for value in values
        ]

    def record(values: list[dict[str, Any]]) -> None:
        snapshots.append(evidence(values))
        del snapshots[:-6]

    while time.monotonic() < deadline:
        registry_budget = deadline - time.monotonic()
        if registry_budget <= 0:
            break
        try:
            instances = matching_shell_instances(
                runtime_paths,
                timeout=min(6, registry_budget),
            )
        except ManagerError as error:
            if time.monotonic() < deadline:
                raise
            deadline_operation_error = str(error)
            break
        record(instances)
        now = time.monotonic()

        if not instances:
            if empty_since is None:
                empty_since = now
            if now - empty_since >= max(0.0, quiet_period - 1e-9):
                return
            sleep_for = min(
                poll_interval,
                max(0.0, deadline - now),
                max(0.0, quiet_period - (now - empty_since)),
            )
            if sleep_for > 0:
                time.sleep(sleep_for)
            continue

        kill_budget = deadline - time.monotonic()
        if kill_budget <= 0:
            break
        empty_since = None
        try:
            subprocess.run(
                command,
                check=False,
                capture_output=True,
                text=True,
                timeout=min(6, kill_budget),
                env=runtime_environment(runtime_paths),
            )
        except (OSError, subprocess.SubprocessError) as error:
            if time.monotonic() < deadline:
                raise ManagerError(f"cannot stop Omarchy shell: {error}") from error
            deadline_operation_error = f"cannot stop Omarchy shell: {error}"
            break
        now = time.monotonic()
        if now < deadline:
            time.sleep(min(poll_interval, deadline - now))

    # The last in-flight command may have replaced the selected registration.
    # Spend at most the explicit evidence grace on one final snapshot, and
    # retain the last good evidence if that diagnostic read itself fails.
    final_snapshot_error: str | None = None
    evidence_budget = evidence_deadline - time.monotonic()
    if evidence_budget > 0:
        try:
            instances = matching_shell_instances(
                runtime_paths,
                timeout=min(final_snapshot_limit, evidence_budget),
            )
        except ManagerError as error:
            final_snapshot_error = str(error)
        else:
            record(instances)
    else:
        final_snapshot_error = "evidence deadline exhausted before final registry snapshot"
    remaining = evidence(instances)
    detail = (
        "Quickshell registry did not converge before the drain deadline; "
        f"remaining={json.dumps(remaining, sort_keys=True)}; "
        f"snapshots={json.dumps(snapshots, sort_keys=True)}"
    )
    if deadline_operation_error is not None:
        detail += "; deadline_operation_error=" + json.dumps(
            deadline_operation_error
        )
    if final_snapshot_error is not None:
        detail += "; final_snapshot_error=" + json.dumps(final_snapshot_error)
    raise ManagerError(detail)


def runtime_environment(runtime_paths: dict[str, Path]) -> dict[str, str]:
    environment = os.environ.copy()
    omarchy_root = runtime_paths.get("omarchy_root")
    if omarchy_root is None:
        shell = runtime_paths.get("shell")
        if shell is not None:
            omarchy_root = shell.parent.parent
    if omarchy_root is not None:
        environment["OMARCHY_PATH"] = str(omarchy_root)
        environment["PATH"] = (
            str(omarchy_root / "bin")
            + os.pathsep
            + environment.get("PATH", "")
        )
    return environment


def plugin_snapshot(runtime_paths: dict[str, Path]) -> dict[str, dict[str, Any]]:
    result = shell_call(runtime_paths, ["shell", "listPlugins"])
    try:
        values = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise ManagerError("shell returned malformed plugin state") from error
    if not isinstance(values, list):
        raise ManagerError("shell plugin state is not an array")
    return {
        str(value["id"]): value
        for value in values
        if isinstance(value, dict) and value.get("id")
    }


def activation_verification(
    config: dict[str, Any],
    plugins: dict[str, dict[str, Any]],
    state: dict[str, Any],
) -> tuple[bool, str]:
    managed = set(state["plugins"])
    activation = state["activation"]
    layout_ids = {
        entry_id(entry)
        for region in REGIONS
        for entry in config["bar"]["layout"][region]
    }
    active_bar = str(activation["activeBar"])
    registry_enabled = layout_ids | {active_bar}
    service_ids = set(activation["enableServices"])
    configured_services = {
        entry_id(entry) for entry in config["plugins"]
    }
    missing = managed - plugins.keys()
    disabled = {
        plugin_id
        for plugin_id in registry_enabled
        if plugins.get(plugin_id, {}).get("enabled") is not True
    }
    missing_services = service_ids - configured_services
    active = plugins.get(active_bar, {}).get("active") is True
    ready = not missing and not disabled and not missing_services and active
    detail = (
        f"missing={sorted(missing)}, disabled={sorted(disabled)}, "
        f"services={sorted(missing_services)}, active={active}"
    )
    return ready, detail


def verify(
    runtime_paths: dict[str, Path],
    state: dict[str, Any],
    target: str,
    timeout: float = 30,
) -> None:
    deadline = time.monotonic() + timeout
    managed = set(state["plugins"])
    activation = state["activation"]
    allowed = set(activation.get("continuityPlugins") or [])
    detail = "plugin registry is not ready"
    while time.monotonic() < deadline:
        try:
            plugins = plugin_snapshot(runtime_paths)
            if target == "shibumi":
                ready, detail = activation_verification(
                    current_config(runtime_paths),
                    plugins,
                    state,
                )
            else:
                layout_ids = {
                    entry_id(entry)
                    for region in REGIONS
                    for entry in current_config(runtime_paths)["bar"]["layout"][region]
                }
                allowed = set(activation["enableServices"]) | layout_ids
                enabled = {
                    plugin_id
                    for plugin_id in managed
                    if plugins.get(plugin_id, {}).get("enabled") is True
                } - allowed
                stock = plugins.get("omarchy.bar", {}).get("active") is True
                active = (
                    plugins.get(str(activation["activeBar"]), {}).get("active")
                    is True
                )
                ready = stock and not active and not enabled
                detail = (
                    f"stock={stock}, shibumi={active}, enabled={sorted(enabled)}"
                )
            if ready:
                ping = shell_call(runtime_paths, ["shell", "ping"])
                if ping.returncode == 0 and ping.stdout.strip() == "ok":
                    return
        except ManagerError as error:
            detail = str(error)
        time.sleep(0.15)
    raise ManagerError(f"{target} verification failed: {detail}")


def status_path(runtime_paths: dict[str, Path]) -> Path:
    return runtime_paths["state"] / "switch-status.json"


def write_status(
    runtime_paths: dict[str, Path], target: str, phase: str, detail: str = ""
) -> None:
    atomic_write(
        status_path(runtime_paths),
        encode(
            {
                "schemaVersion": 1,
                "target": target,
                "phase": phase,
                "detail": detail,
                "updatedEpoch": int(time.time()),
            }
        ),
    )


def perform(target: str) -> int:
    runtime_target = "shibumi" if target in {"shibumi", "v1", "v2"} else target
    runtime_paths = paths()
    runtime_paths["lock"].parent.mkdir(parents=True, exist_ok=True)
    with runtime_paths["lock"].open("a+") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise ManagerError("another Shibumi lifecycle operation is running") from error

        # A killed worker may leave only the unpublished preparation. It is
        # safe to discard under the lifecycle lock because no live mutation
        # occurs before the atomic publication rename.
        discard_private_switch_transactions(runtime_paths)
        state = load_state(runtime_paths)
        current = current_config(runtime_paths)
        defaults = normalize(read_json(runtime_paths["defaults"], "shell defaults"))
        profiles = load_layout_profiles(runtime_paths)
        layouts = profiles["layouts"]
        center_anchors = profiles["centerAnchors"]
        current_shell = (
            "shibumi"
            if str(current["bar"].get("id") or "omarchy.bar")
            == str(state["activation"]["activeBar"])
            else "omarchy"
        )
        trusted_layout = layouts.get(current_shell)
        current_anchor = current["bar"].get("centerAnchor")
        center_anchors[current_shell] = (
            current_anchor if isinstance(current_anchor, str) else ""
        )
        layouts[current_shell] = snapshot_layout(
            current,
            current_shell,
            state,
            legacy=trusted_layout is None,
            trusted_layout=trusted_layout,
        )
        target_layout = layouts.get(runtime_target)
        if target_layout is None:
            target_layout = initial_layout(runtime_target, defaults, state)
            layouts[runtime_target] = copy_layout(target_layout)
        target_center_anchor = center_anchors.get(runtime_target)
        if target_center_anchor is None:
            target_center_anchor = initial_center_anchor(
                runtime_target, defaults, state
            )
            center_anchors[runtime_target] = target_center_anchor
        desired = (
            activate_config(current, state, target_layout)
            if runtime_target == "shibumi"
            else deactivate_config(
                current,
                defaults,
                state,
                target_layout,
                target_center_anchor,
            )
        )
        desired = apply_shibumi_variant(desired, target)
        desired_state = copy.deepcopy(state)
        desired_activation = desired_state["activation"]
        desired_activation["mode"] = (
            "managed" if runtime_target == "shibumi" else "external"
        )
        desired_activation["layoutPolicy"] = (
            "managed" if runtime_target == "shibumi" else "preserved"
        )
        desired_activation["configuredBar"] = str(
            desired["bar"].get("id") or "omarchy.bar"
        )
        desired_state["updatedEpoch"] = int(time.time())
        state_path = runtime_paths["state"] / "install.json"
        config_path = runtime_paths["config"]
        existed = config_path.is_file()
        (
            transaction,
            snapshot,
            state_snapshot,
            journal,
            journal_path,
        ) = prepare_switch_transaction(
            runtime_paths,
            target,
            config_path,
            state_path,
            existed,
        )

        def cleanup_transaction() -> None:
            retire_switch_transaction(runtime_paths, transaction)

        try:
            write_status(runtime_paths, target, "snapshot")
            stop_shell(runtime_paths)
            atomic_write(config_path, encode(desired))
            atomic_write(state_path, encode(desired_state))
            write_status(runtime_paths, target, "apply")
            reload_shell(runtime_paths)
            write_status(runtime_paths, target, "verify")
            verify(runtime_paths, state, runtime_target)
            atomic_write(profile_path(runtime_paths), encode(profiles))
        except Exception as operation_error:
            try:
                try:
                    stop_shell(runtime_paths)
                except ManagerError:
                    pass
                if existed:
                    atomic_write(config_path, snapshot.read_bytes())
                else:
                    durable_unlink(config_path)
                atomic_write(state_path, state_snapshot.read_bytes())
                reload_shell(runtime_paths)
            except Exception as rollback_error:
                journal["phase"] = "recovery-required"
                journal["detail"] = (
                    f"switch failed: {operation_error}; "
                    f"rollback failed: {rollback_error}"
                )
                try:
                    atomic_write(journal_path, encode(journal))
                except Exception:
                    pass
                try:
                    write_status(
                        runtime_paths,
                        target,
                        "recovery-required",
                        f"recovery journal retained at {transaction}",
                    )
                except Exception:
                    pass
                raise ManagerError(
                    "shell switch rollback failed; recovery journal retained at "
                    f"{transaction}"
                ) from rollback_error
            else:
                journal["phase"] = "rolled-back"
                journal["detail"] = str(operation_error)
                atomic_write(journal_path, encode(journal))
                write_status(
                    runtime_paths, target, "error", str(operation_error)
                )
                cleanup_transaction()
            raise
        else:
            journal["phase"] = "committed"
            atomic_write(journal_path, encode(journal))
            write_status(runtime_paths, target, "complete")
            cleanup_transaction()
    return 0


def recover_locked(runtime_paths: dict[str, Path]) -> int:
    discard_private_switch_transactions(runtime_paths)
    transaction = runtime_paths["state"] / "switch-transaction"
    if transaction.is_symlink():
        raise ManagerError(f"refusing symlinked switch transaction: {transaction}")
    if not transaction.exists():
        return 0
    if not transaction.is_dir():
        raise ManagerError(f"switch transaction is not a directory: {transaction}")

    journal_path = transaction / "journal.json"
    if journal_path.is_symlink() or not journal_path.is_file():
        raise ManagerError("switch journal is missing or unsafe")
    journal = read_json(journal_path, "switch journal")
    schema = journal.get("schemaVersion")
    target = journal.get("target")
    config_existed = journal.get("configExisted")
    phase = journal.get("phase")
    if type(schema) is not int or schema != 1:
        raise ManagerError("switch journal schema is unsupported")
    if not isinstance(target, str) or target not in {
        "omarchy", "shibumi", "v1", "v2"
    }:
        raise ManagerError("switch journal target is malformed")
    if not isinstance(config_existed, bool):
        raise ManagerError("switch journal configExisted is malformed")
    if not isinstance(phase, str) or phase not in {
        "prepared", "recovery-required", "committed", "rolled-back"
    }:
        raise ManagerError("switch journal phase is malformed")

    if phase in {"committed", "rolled-back"}:
        detail = journal.get("detail", "")
        if not isinstance(detail, str):
            raise ManagerError("switch terminal journal detail is malformed")
        write_status(
            runtime_paths,
            target,
            "complete" if phase == "committed" else "error",
            detail,
        )
        retire_switch_transaction(runtime_paths, transaction)
        return 0

    snapshot = transaction / "shell.json.before"
    state_snapshot = transaction / "install.json.before"
    if config_existed and (snapshot.is_symlink() or not snapshot.is_file()):
        raise ManagerError("switch snapshot is missing or unsafe")
    if state_snapshot.is_symlink() or not state_snapshot.is_file():
        raise ManagerError("switch state snapshot is missing or unsafe")
    # Read each restoration payload exactly once before stopping the shell.
    # Validation and restoration use the same immutable byte buffers so an
    # external change cannot cross the destructive boundary unnoticed.
    try:
        config_payload = snapshot.read_bytes() if config_existed else None
        state_payload = state_snapshot.read_bytes()
    except OSError as error:
        raise ManagerError(f"cannot read switch snapshot: {error}") from error
    if config_payload:
        # A zero-byte user config is intentionally supported by current_config
        # as "use defaults" and must still be restored byte-for-byte.
        decode_json(config_payload, "switch snapshot")
    saved_state = decode_json(state_payload, "switch state snapshot")
    validate_state(saved_state, "switch state snapshot")

    stop_shell(runtime_paths)
    if config_existed:
        atomic_write(runtime_paths["config"], config_payload)
    else:
        durable_unlink(runtime_paths["config"])
    atomic_write(
        runtime_paths["state"] / "install.json",
        state_payload,
    )
    reload_shell(runtime_paths)
    write_status(runtime_paths, str(target), "recovered")
    retire_switch_transaction(runtime_paths, transaction)
    return 0


def recover() -> int:
    runtime_paths = paths()
    runtime_paths["lock"].parent.mkdir(parents=True, exist_ok=True)
    with runtime_paths["lock"].open("a+") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise ManagerError(
                "another Shibumi lifecycle operation is running"
            ) from error
        return recover_locked(runtime_paths)


def request(target: str) -> int:
    runtime_paths = paths()
    load_state(runtime_paths)
    request_lock_path = runtime_paths["state"] / "switch-request.lock"
    request_lock_path.parent.mkdir(parents=True, exist_ok=True)
    with request_lock_path.open("a+") as request_lock:
        fcntl.flock(request_lock.fileno(), fcntl.LOCK_EX)
        current_status: dict[str, Any] = {}
        if status_path(runtime_paths).is_file():
            current_status = read_json(status_path(runtime_paths), "switch status")
        current_phase = str(current_status.get("phase") or "")
        current_age = max(
            0,
            int(time.time()) - int(current_status.get("updatedEpoch") or 0),
        )
        if current_phase in {"queued", "snapshot", "apply", "verify"} \
                and current_age <= 120:
            raise ManagerError("another Shibumi lifecycle operation is running")
        write_status(runtime_paths, target, "queued")
        try:
            subprocess.Popen(
                [sys.executable, str(Path(__file__).resolve()), "_worker", target],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                close_fds=True,
            )
        except OSError as error:
            write_status(runtime_paths, target, "error", str(error))
            raise ManagerError(f"cannot launch switch worker: {error}") from error
    print(json.dumps({"accepted": True, "target": target}))
    return 0


def show_status() -> int:
    runtime_paths = paths()
    state = load_state(runtime_paths)
    config = current_config(runtime_paths)
    active = str(config["bar"].get("id") or "omarchy.bar")
    switch_status: dict[str, Any] = {}
    if status_path(runtime_paths).is_file():
        switch_status = read_json(status_path(runtime_paths), "switch status")
    shibumi = config["bar"].get("shibumi")
    presentation = shibumi.get("presentation") \
        if isinstance(shibumi, dict) else {}
    shell_style = str(presentation.get("shellStyle") or "shibumi") \
        if isinstance(presentation, dict) else "shibumi"
    print(
        json.dumps(
            {
                "active": "shibumi"
                if active == state["activation"]["activeBar"]
                else "omarchy",
                "barId": active,
                "variant": "v1" if shell_style == "shibumi" else "v2",
                "switch": switch_status,
            }
        )
    )
    return 0


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="shibumi-manager")
    commands = result.add_subparsers(dest="command", required=True)
    for name in ("activate", "deactivate", "request"):
        command = commands.add_parser(name)
        if name == "request":
            command.add_argument(
                "target", choices=("shibumi", "v1", "v2", "omarchy")
            )
    worker = commands.add_parser("_worker")
    worker.add_argument(
        "target", choices=("shibumi", "v1", "v2", "omarchy")
    )
    commands.add_parser("status")
    commands.add_parser("recover")
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "activate":
            return perform("shibumi")
        if args.command == "deactivate":
            return perform("omarchy")
        if args.command == "request":
            return request(args.target)
        if args.command == "_worker":
            try:
                return perform(args.target)
            except ManagerError as error:
                write_status(paths(), args.target, "error", str(error))
                return 1
        if args.command == "recover":
            return recover()
        return show_status()
    except ManagerError as error:
        print(f"shibumi-manager: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
