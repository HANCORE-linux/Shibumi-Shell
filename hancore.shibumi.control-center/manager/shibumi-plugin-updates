#!/bin/bash

# Scan independently installed Git plugins before offering a multi-selection.
# Updates themselves remain delegated to Omarchy's validating updater.

set -euo pipefail

export GIT_TERMINAL_PROMPT=0
export GIT_ASKPASS=/bin/false
export SSH_ASKPASS=/bin/false
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}"
plugins_dir="${SHIBUMI_PLUGIN_DIR:-$HOME/.config/omarchy/plugins}"
mode="select"

if [[ ${1:-} == "--list" ]]; then
  mode="list"
  shift
fi
if (( $# > 0 )); then
  echo "Usage: shibumi-plugin-updates [--list]" >&2
  exit 2
fi

[[ -d $plugins_dir ]] || {
  echo "No plugin directory found at $plugins_dir." >&2
  exit 1
}

valid_plugin_id() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != *..* ]]
}

is_shibumi_suite_plugin() {
  local manifest="$1/manifest.json"
  [[ -f $manifest ]] || return 1
  [[ $(jq -r '.["x-shibumi"].suiteId // ""' "$manifest" 2>/dev/null) == "hancore.shibumi" ]]
}

updates=()
checked=()
unmanaged=()
fetch_failed=()

for plugin_dir in "$plugins_dir"/*/; do
  [[ -d $plugin_dir ]] || continue
  plugin_dir=${plugin_dir%/}
  plugin_id=${plugin_dir##*/}
  valid_plugin_id "$plugin_id" || continue
  is_shibumi_suite_plugin "$plugin_dir" && continue

  if [[ -L $plugin_dir || ! -d $plugin_dir/.git || -L $plugin_dir/.git ]]; then
    unmanaged+=("$plugin_id")
    continue
  fi

  git_file_protocol=never
  [[ ${SHIBUMI_ALLOW_FILE_REMOTE:-0} == 1 ]] && git_file_protocol=always
  git_plugin=(git -C "$plugin_dir"
    -c core.fsmonitor=
    -c core.hooksPath=/dev/null
    -c core.askPass=/bin/false
    -c core.gitProxy=
    -c core.sshCommand="$GIT_SSH_COMMAND"
    -c credential.helper=
    -c protocol.allow=never
    -c protocol.ext.allow=never
    -c protocol.file.allow="$git_file_protocol"
    -c protocol.git.allow=never
    -c protocol.http.allow=always
    -c protocol.https.allow=always
    -c protocol.ssh.allow=always)

  if ! remote_head=$("${git_plugin[@]}" ls-remote --exit-code --quiet \
      origin HEAD 2>/dev/null | awk 'NR == 1 { print $1 }') \
      || [[ ! $remote_head =~ ^[0-9A-Fa-f]{40}$ \
        && ! $remote_head =~ ^[0-9A-Fa-f]{64}$ ]]; then
    fetch_failed+=("$plugin_id")
    continue
  fi
  if ! "${git_plugin[@]}" fetch --quiet --no-write-fetch-head origin \
      "$remote_head"; then
    fetch_failed+=("$plugin_id")
    continue
  fi
  if ! local_head=$("${git_plugin[@]}" rev-parse --verify 'HEAD^{commit}' \
      2>/dev/null) \
      || ! remote_commit=$("${git_plugin[@]}" rev-parse --verify \
        "$remote_head^{commit}" 2>/dev/null) \
      || [[ $remote_commit != "$remote_head" ]]; then
    fetch_failed+=("$plugin_id (invalid checkout)")
    continue
  fi
  remote_head=$remote_commit
  if [[ $local_head == "$remote_head" ]]; then
    checked+=("$plugin_id")
    continue
  fi
  if "${git_plugin[@]}" merge-base --is-ancestor "$local_head" \
      "$remote_head"; then
    checked+=("$plugin_id")
    updates+=("$plugin_id")
    continue
  else
    relation_rc=$?
    if ((relation_rc != 1)); then
      fetch_failed+=("$plugin_id (invalid history)")
      continue
    fi
  fi
  if "${git_plugin[@]}" merge-base --is-ancestor "$remote_head" \
      "$local_head"; then
    checked+=("$plugin_id")
  else
    relation_rc=$?
    if ((relation_rc == 1)); then
      fetch_failed+=("$plugin_id (diverged)")
    else
      fetch_failed+=("$plugin_id (invalid history)")
    fi
  fi
done

if [[ $mode == "list" ]]; then
  scan_epoch=${SHIBUMI_PLUGIN_SCAN_EPOCH:-0}
  [[ $scan_epoch =~ ^[0-9]+$ ]] || scan_epoch=0
  printf 'PLUGIN_SCAN_EPOCH=%s\n' "$scan_epoch"
  printf 'PLUGIN_UPDATE_COUNT=%d\n' "${#updates[@]}"
  printf 'PLUGIN_CHECKED_COUNT=%d\n' "${#checked[@]}"
  printf 'PLUGIN_UNMANAGED_COUNT=%d\n' "${#unmanaged[@]}"
  printf 'PLUGIN_FETCH_FAILED_COUNT=%d\n' "${#fetch_failed[@]}"
  for plugin_id in "${updates[@]}"; do
    printf 'PLUGIN_UPDATE_ID=%s\n' "$plugin_id"
  done
  for plugin_id in "${unmanaged[@]}"; do
    printf 'PLUGIN_UNMANAGED_ID=%s\n' "$plugin_id"
  done
  for plugin_id in "${fetch_failed[@]}"; do
    printf 'PLUGIN_FETCH_FAILED_ID=%s\n' "$plugin_id"
  done
  exit 0
fi

echo
suffix="s"
(( ${#updates[@]} == 1 )) && suffix=""
if (( ${#updates[@]} == 0 )); then
  echo "0 plugin updates available."
else
  printf '%d plugin update%s available.\n' "${#updates[@]}" "$suffix"
fi

if (( ${#unmanaged[@]} > 0 )); then
  echo
  echo "Not automatically checkable (not a Git checkout):"
  printf '  %s\n' "${unmanaged[@]}"
fi
if (( ${#fetch_failed[@]} > 0 )); then
  echo
  echo "Check failed:"
  printf '  %s\n' "${fetch_failed[@]}"
fi
if (( ${#updates[@]} == 0 )); then
  exit $(( ${#fetch_failed[@]} > 0 ? 1 : 0 ))
fi

echo
selected=$(printf '%s\n' "${updates[@]}" | gum choose --no-limit \
  --ordered --header="Select plugins to update (${#updates[@]} available)") || exit $?
[[ -n $selected ]] || {
  echo "No plugins selected."
  exit 0
}

selected_ids=()
while IFS= read -r plugin_id; do
  [[ -n $plugin_id ]] || continue
  valid_plugin_id "$plugin_id" || continue
  for candidate in "${updates[@]}"; do
    if [[ $plugin_id == "$candidate" ]]; then
      selected_ids+=("$plugin_id")
      break
    fi
  done
done <<< "$selected"

(( ${#selected_ids[@]} > 0 )) || {
  echo "No valid plugins selected."
  exit 1
}

echo
update_failed=0
for plugin_id in "${selected_ids[@]}"; do
  echo "Reviewing $plugin_id: if Omarchy opens a diff pager, exit it with q; then confirm the update."
  if ! omarchy-plugin-update "$plugin_id"; then
    update_failed=1
  fi
done
exit "$update_failed"
