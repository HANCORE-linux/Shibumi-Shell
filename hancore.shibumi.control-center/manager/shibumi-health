#!/usr/bin/env python3
"""Read-only Shibumi runtime, package, and source-checkout diagnostics."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import subprocess
import time
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import Any


SUITE_ID = "hancore.shibumi"
MANAGED_MARKER = ".shibumi-managed.json"
STATUS_ORDER = {"error": 0, "warning": 1, "ok": 2, "info": 3}
ERROR_PATTERNS = re.compile(
    r"binding loop|referenceerror|typeerror|failed to load|error loading|"
    r"could not resolve type|is not a type|cannot assign|loader.*error|"
    r"host.facade|provider.*compatib",
    re.IGNORECASE,
)
SENSITIVE_PATTERNS = re.compile(
    r"authorization|cookie|credential|password|secret|ssid|token",
    re.IGNORECASE,
)
PACKAGE_NAME = "shibumi-shell"
AUR_INFO_URL = (
    "https://aur.archlinux.org/rpc/v5/info?arg%5B%5D=shibumi-shell"
)


@dataclass
class Check:
    id: str
    group: str
    label: str
    status: str
    value: str
    detail: str = ""
    component: str = ""
    action: str = ""


def safe_text(value: Any, limit: int = 320) -> str:
    text = " ".join(str(value or "").replace("\x00", "").split())
    return text if len(text) <= limit else text[: limit - 1] + "…"


def read_json(path: Path) -> dict[str, Any]:
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise ValueError("expected a JSON object")
    return value


def read_json_list(path: Path) -> list[Any]:
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, list):
        raise ValueError("expected a JSON array")
    return value


def run(
    command: list[str],
    *,
    timeout: float = 5,
    environment: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        check=False,
        capture_output=True,
        text=True,
        timeout=timeout,
        env=environment,
    )


def configured_timeout(name: str, default: float) -> float:
    try:
        value = float(os.environ.get(name, default))
    except (TypeError, ValueError):
        return default
    return min(default, max(0.05, value))


def payload_digest(directory: Path) -> str:
    digest = hashlib.sha256()
    digest.update(b"shibumi-plugin-payload-v1\0")
    for path in sorted(
        directory.rglob("*"), key=lambda item: item.relative_to(directory).as_posix()
    ):
        relative = path.relative_to(directory).as_posix()
        if relative == MANAGED_MARKER:
            continue
        metadata = path.lstat()
        if path.is_symlink():
            raise ValueError(f"symlink in payload: {relative}")
        if path.is_dir():
            continue
        if not stat.S_ISREG(metadata.st_mode):
            raise ValueError(f"special file in payload: {relative}")
        digest.update(b"file\0")
        digest.update(relative.encode("utf-8"))
        digest.update(b"\0")
        digest.update(f"{metadata.st_mode & 0o111:o}".encode("ascii"))
        digest.update(b"\0")
        with path.open("rb") as handle:
            for block in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(block)
        digest.update(b"\0")
    return digest.hexdigest()


class Probe:
    def __init__(self, fetch: bool) -> None:
        self.fetch = fetch
        self.home = Path(os.environ.get("SHIBUMI_HEALTH_HOME", Path.home()))
        config_home = Path(
            os.environ.get("XDG_CONFIG_HOME", self.home / ".config")
        )
        state_home = Path(
            os.environ.get("XDG_STATE_HOME", self.home / ".local/state")
        )
        self.omarchy_root = Path(
            os.environ.get("OMARCHY_PATH", "/usr/share/omarchy")
        )
        self.config_path = Path(
            os.environ.get(
                "SHIBUMI_CONFIG_FILE", config_home / "omarchy/shell.json"
            )
        )
        self.defaults_path = Path(
            os.environ.get(
                "SHIBUMI_DEFAULT_CONFIG",
                self.omarchy_root / "config/omarchy/shell.json",
            )
        )
        self.plugin_dir = Path(
            os.environ.get(
                "SHIBUMI_PLUGIN_DIR", config_home / "omarchy/plugins"
            )
        )
        self.state_dir = Path(
            os.environ.get("SHIBUMI_STATE_DIR", state_home / "shibumi")
        )
        self.checks: list[Check] = []
        self.state: dict[str, Any] = {}
        self.config: dict[str, Any] = {}
        self.registry: list[dict[str, Any]] = []
        self.processes: list[dict[str, Any]] = []
        self.production_pids: list[int] = []
        self.production_responsive = False
        self.process_probe_failed = False

    def add(
        self,
        check_id: str,
        group: str,
        label: str,
        status: str,
        value: str,
        detail: str = "",
        component: str = "",
        action: str = "",
    ) -> None:
        self.checks.append(
            Check(
                check_id,
                group,
                label,
                status if status in STATUS_ORDER else "error",
                safe_text(value, 120),
                safe_text(detail, 900),
                self.display_path(component),
                safe_text(action, 240),
            )
        )

    def display_path(self, value: str | Path) -> str:
        text = self.redact_home_paths(value)
        return safe_text(text, 240)

    def redact_home_paths(self, value: str | Path) -> str:
        """Hide user names in both the active and foreign home paths."""
        text = str(value or "")
        home = str(self.home)
        if home:
            if text == home:
                text = "~"
            else:
                text = text.replace(home + "/", "~/")
        return re.sub(r"(?<![A-Za-z0-9._-])/home/[^/\s]+", "~", text)

    def load_state_and_config(self) -> None:
        state_path = self.state_dir / "install.json"
        try:
            self.state = read_json(state_path)
            plugins = self.state.get("plugins")
            activation = self.state.get("activation")
            if (
                self.state.get("suiteId") != SUITE_ID
                or not isinstance(plugins, list)
                or not isinstance(activation, dict)
            ):
                raise ValueError("unsupported install-state schema")
            origin = str(self.state.get("installOrigin") or "checkout")
            if origin not in ("checkout", "package"):
                raise ValueError("unsupported install origin")
            if origin == "package" and (
                self.state.get("packageName") != PACKAGE_NAME
                or not isinstance(self.state.get("packageVersion"), str)
                or not self.state.get("packageVersion")
            ):
                raise ValueError("package install metadata is incomplete")
        except (OSError, ValueError, json.JSONDecodeError) as error:
            self.add(
                "install-state",
                "Runtime",
                "Install state",
                "error",
                "Invalid",
                str(error),
                state_path,
                "Run shibumi-suite repair after reviewing the state file.",
            )
            self.state = {}

        source = (
            self.config_path
            if self.config_path.is_file() and self.config_path.stat().st_size > 0
            else self.defaults_path
        )
        try:
            self.config = read_json(source)
            if not isinstance(self.config.get("bar"), dict):
                raise ValueError("bar configuration is missing")
            shibumi = self.config["bar"].get("shibumi")
            if shibumi is not None and not isinstance(shibumi, dict):
                raise ValueError("bar.shibumi must be an object")
            self.add(
                "configuration",
                "Runtime",
                "Configuration",
                "ok",
                "Schema valid",
                "The active shell configuration is parseable.",
                source,
            )
        except (OSError, ValueError, json.JSONDecodeError) as error:
            self.add(
                "configuration",
                "Runtime",
                "Configuration",
                "error",
                "Invalid",
                str(error),
                source,
                "Repair the configuration before reloading the shell.",
            )
            self.config = {"bar": {}}

    def load_registry(self) -> None:
        fixture = os.environ.get("SHIBUMI_HEALTH_REGISTRY_FILE")
        try:
            if fixture:
                values = read_json_list(Path(fixture))
            else:
                command = self.omarchy_root / "bin/omarchy-shell"
                environment = os.environ.copy()
                environment["OMARCHY_PATH"] = str(self.omarchy_root)
                result = run(
                    [str(command), "shell", "listPlugins"],
                    timeout=5,
                    environment=environment,
                )
                if result.returncode != 0:
                    raise RuntimeError(result.stderr or result.stdout or "registry failed")
                values = json.loads(result.stdout)
            if not isinstance(values, list):
                raise ValueError("registry result is not an array")
            self.registry = [item for item in values if isinstance(item, dict)]
        except (
            OSError,
            ValueError,
            RuntimeError,
            json.JSONDecodeError,
            subprocess.TimeoutExpired,
        ) as error:
            self.add(
                "plugin-registry",
                "Plugins",
                "Plugin registry",
                "error",
                "Unavailable",
                str(error),
                self.omarchy_root / "bin/omarchy-shell",
                "Confirm that the Omarchy shell answers IPC requests.",
            )
            self.registry = []

    def load_processes(self) -> None:
        fixture = os.environ.get("SHIBUMI_HEALTH_PROCESS_FILE")
        try:
            if fixture:
                values = read_json_list(Path(fixture))
            else:
                result = run(["qs", "list", "--all", "--json"], timeout=3)
                if result.returncode != 0:
                    raise RuntimeError(
                        result.stderr or result.stdout or "instance query failed"
                    )
                if result.stdout == "No running instances.\n":
                    values = []
                else:
                    values = json.loads(result.stdout)
                if not isinstance(values, list):
                    raise ValueError("instance result is not an array")

            self.processes = [item for item in values if isinstance(item, dict)]
            production_config = os.path.normpath(
                str(self.omarchy_root / "shell/shell.qml")
            )
            self.production_pids = sorted(
                {
                    int(item.get("pid", 0))
                    for item in self.processes
                    if os.path.normpath(str(item.get("config_path") or ""))
                    == production_config
                    and int(item.get("pid", 0)) > 0
                }
            )

            fixture_live = os.environ.get("SHIBUMI_HEALTH_PROCESS_LIVE")
            if fixture and fixture_live is not None:
                self.production_responsive = fixture_live.lower() == "true"
            elif fixture:
                self.production_responsive = True
            elif len(self.production_pids) == 1:
                command = self.omarchy_root / "bin/omarchy-shell"
                environment = os.environ.copy()
                environment["OMARCHY_PATH"] = str(self.omarchy_root)
                result = run(
                    [str(command), "shell", "ping"],
                    timeout=3,
                    environment=environment,
                )
                self.production_responsive = (
                    result.returncode == 0 and result.stdout.strip() == "ok"
                )
        except (
            OSError,
            RuntimeError,
            ValueError,
            json.JSONDecodeError,
            subprocess.TimeoutExpired,
        ) as error:
            self.process_probe_failed = True
            self.add(
                "quickshell-process",
                "Runtime",
                "Quickshell process",
                "error",
                "Check failed",
                str(error),
                "qs list --all --json",
            )

    def load_outputs(self) -> list[dict[str, Any]]:
        fixture = os.environ.get("SHIBUMI_HEALTH_OUTPUT_FILE")
        try:
            if fixture:
                values = read_json_list(Path(fixture))
            else:
                result = run(["hyprctl", "monitors", "-j"], timeout=4)
                if result.returncode != 0:
                    raise RuntimeError(result.stderr or result.stdout or "hyprctl failed")
                values = json.loads(result.stdout)
            return [item for item in values if isinstance(item, dict)]
        except (
            OSError,
            RuntimeError,
            ValueError,
            json.JSONDecodeError,
            subprocess.TimeoutExpired,
        ) as error:
            self.add(
                "outputs",
                "Runtime",
                "Outputs",
                "error",
                "Unavailable",
                str(error),
                "hyprctl monitors -j",
                "Confirm that the active Hyprland session is reachable.",
            )
            return []

    def check_bar_and_outputs(self, outputs: list[dict[str, Any]]) -> None:
        bar = self.config.get("bar") if isinstance(self.config.get("bar"), dict) else {}
        configured_id = str(bar.get("id") or "omarchy.bar")
        running = [
            str(item.get("id") or "")
            for item in self.registry
            if item.get("active") is True and "bar" in (item.get("kinds") or [])
        ]
        running_id = running[0] if len(running) == 1 else ""
        presentation = bar.get("shibumi") if isinstance(bar.get("shibumi"), dict) else {}
        presentation = (
            presentation.get("presentation")
            if isinstance(presentation.get("presentation"), dict)
            else {}
        )
        shell_style = str(presentation.get("shellStyle") or "shibumi")
        selected = "Omarchy" if configured_id == "omarchy.bar" else (
            "Shibumi V1" if shell_style == "shibumi" else "Shibumi V2"
        )
        running_label = "None" if not running else (
            "Multiple" if len(running) > 1 else (
                "Omarchy" if running_id == "omarchy.bar" else selected
            )
        )
        matches = len(running) == 1 and running_id == configured_id
        self.add(
            "bar-runtime",
            "Runtime",
            "Active bar",
            "ok" if matches else "error",
            selected if matches else f"{selected} → {running_label}",
            "Selection and runtime agree." if matches
            else "The configured bar does not match the single active bar.",
            self.config_path,
            "Run the guarded bar handoff again." if not matches else "",
        )

        form = "Islands" if shell_style == "shibumi" else shell_style.title()
        position = str(bar.get("position") or "top").title()
        output_values = []
        for output in outputs:
            name = safe_text(output.get("name"), 48)
            scale = output.get("scale")
            output_values.append(f"{name} @{scale:g}×" if isinstance(scale, (int, float)) else name)
        if outputs:
            self.add(
                "bar-geometry",
                "Runtime",
                "Bar geometry",
                "ok",
                f"{form} · {position} · {len(outputs)} output(s)",
                ", ".join(output_values),
                "hyprctl monitors -j",
            )

    def check_processes(self) -> None:
        if self.process_probe_failed:
            return
        count = len(self.production_pids)
        responsive = count == 1 and self.production_responsive
        status = "ok" if responsive else "error"
        if responsive:
            value = "1 production process"
            detail = (
                f"PID {self.production_pids[0]} owns "
                f"{self.omarchy_root}/shell and answers IPC."
            )
        elif count == 1:
            value = "Production process unresponsive"
            detail = (
                f"PID {self.production_pids[0]} is registered for "
                f"{self.omarchy_root}/shell but does not answer IPC."
            )
        else:
            value = f"{count} production processes"
            detail = (
                "Expected exactly one live Quickshell instance registered for "
                f"{self.omarchy_root}/shell/shell.qml."
            )
        self.add(
            "quickshell-process",
            "Runtime",
            "Quickshell process",
            status,
            value,
            detail,
            "qs list --all --json",
            "Inspect the registered instances before restarting the shell."
            if status == "error" else "",
        )

    def check_plugins(self) -> None:
        expected = [str(value) for value in self.state.get("plugins", [])]
        if not expected:
            return
        expected_set = set(expected)
        digests = self.state.get("pluginDigests")
        digests = digests if isinstance(digests, dict) else {}
        missing: list[str] = []
        stale: list[str] = []
        ownership: list[str] = []
        for plugin_id in expected:
            target = self.plugin_dir / plugin_id
            if not target.is_dir() or target.is_symlink():
                missing.append(plugin_id)
                continue
            marker_path = target / MANAGED_MARKER
            try:
                marker = read_json(marker_path)
                expected_digest = str(digests.get(plugin_id) or "")
                if (
                    marker.get("suiteId") != SUITE_ID
                    or marker.get("pluginId") != plugin_id
                    or marker.get("payloadDigest") != expected_digest
                ):
                    ownership.append(plugin_id)
                    continue
                if payload_digest(target) != expected_digest:
                    stale.append(plugin_id)
            except (OSError, ValueError, json.JSONDecodeError):
                ownership.append(plugin_id)
        extra = sorted(
            path.name
            for path in self.plugin_dir.glob("hancore.shibumi.*")
            if path.name not in expected_set
        )
        problems = missing + stale + ownership + extra
        details = []
        if missing:
            details.append("missing: " + ", ".join(missing))
        if stale:
            details.append("modified/stale: " + ", ".join(stale))
        if ownership:
            details.append("ownership mismatch: " + ", ".join(ownership))
        if extra:
            details.append("unexpected roots: " + ", ".join(extra))
        self.add(
            "managed-plugins",
            "Plugins",
            "Shibumi plugins",
            "error" if problems else "ok",
            f"{len(expected) - len(missing)}/{len(expected)} installed",
            "; ".join(details) if details else "Every managed payload matches its recorded digest.",
            self.plugin_dir,
            "Run shibumi-suite repair after reviewing the affected roots."
            if problems else "",
        )

        registry = {
            str(item.get("id") or ""): item for item in self.registry
        }
        absent = [plugin_id for plugin_id in expected if plugin_id not in registry]
        activation = self.state.get("activation")
        activation = activation if isinstance(activation, dict) else {}
        layout = activation.get("layout")
        layout = layout if isinstance(layout, dict) else {}
        required_enabled = {
            str(plugin_id)
            for region in ("left", "center", "right")
            for plugin_id in (
                layout.get(region) if isinstance(layout.get(region), list) else []
            )
        }
        active_bar = str(activation.get("activeBar") or "")
        if active_bar:
            required_enabled.add(active_bar)
        enabled_services = activation.get("enableServices")
        enabled_services = enabled_services if isinstance(enabled_services, list) else []
        for plugin_id in enabled_services:
            entry = registry.get(str(plugin_id), {})
            kinds = entry.get("kinds") if isinstance(entry, dict) else []
            kinds = kinds if isinstance(kinds, list) else []
            # Quattro's enabled flag follows bar-widget placement for hybrid
            # widget/services. The suite verifier therefore requires only
            # pure services plus the configured layout and active bar.
            if "bar-widget" not in kinds:
                required_enabled.add(str(plugin_id))
        required_enabled &= expected_set
        disabled_required = [
            plugin_id
            for plugin_id in sorted(required_enabled)
            if plugin_id in registry and registry[plugin_id].get("enabled") is not True
        ]
        configured_id = str(
            (self.config.get("bar") or {}).get("id") or "omarchy.bar"
        )
        shibumi_running = configured_id != "omarchy.bar"
        status = "error" if absent or (shibumi_running and disabled_required) else "ok"
        detail = []
        if absent:
            detail.append("not discovered: " + ", ".join(absent))
        if disabled_required:
            detail.append("required but disabled: " + ", ".join(disabled_required))
        if not detail:
            detail.append("All expected roots are discovered and every runtime-required root is enabled.")
        elif not shibumi_running and not absent:
            detail.append("Disabled Shibumi roots are expected while Omarchy is active.")
        self.add(
            "plugin-activation",
            "Plugins",
            "Plugin activation",
            status,
            f"{len(required_enabled) - len(disabled_required)}/{len(required_enabled)} required enabled",
            "; ".join(detail),
            self.plugin_dir,
            "Use the suite repair path; do not toggle suite roots individually."
            if status == "error" else "",
        )

    def check_lifecycle(self) -> None:
        transaction = self.state_dir / "switch-transaction"
        status_path = self.state_dir / "switch-status.json"
        if transaction.exists():
            self.add(
                "lifecycle",
                "Runtime",
                "Lifecycle state",
                "error",
                "Unfinished transaction",
                "A guarded bar switch did not clean up its transaction directory.",
                transaction,
                "Run the continuity manager recovery before switching again.",
            )
            return
        try:
            value = read_json(status_path) if status_path.is_file() else {}
        except (OSError, ValueError, json.JSONDecodeError) as error:
            self.add(
                "lifecycle",
                "Runtime",
                "Lifecycle state",
                "warning",
                "Status unreadable",
                str(error),
                status_path,
            )
            return
        phase = str(value.get("phase") or "idle")
        updated = int(value.get("updatedEpoch") or 0)
        age = max(0, int(time.time()) - updated) if updated else 0
        if phase == "error":
            self.add(
                "lifecycle",
                "Runtime",
                "Lifecycle state",
                "error",
                "Last switch failed",
                value.get("detail") or "The continuity manager reported an error.",
                status_path,
                "Retry only after reviewing the recorded switch failure.",
            )
        elif phase in {"queued", "snapshot", "apply", "verify"}:
            stale = age > 120
            self.add(
                "lifecycle",
                "Runtime",
                "Lifecycle state",
                "error" if stale else "warning",
                "Stale switch" if stale else f"Switch {phase}",
                f"The last lifecycle update is {age} seconds old.",
                status_path,
                "Run continuity recovery before retrying." if stale else "Wait for verification to finish.",
            )
        else:
            self.add(
                "lifecycle",
                "Runtime",
                "Lifecycle state",
                "ok",
                "Settled",
                f"Last recorded phase: {phase}.",
                status_path if status_path.is_file() else self.state_dir,
            )

    def check_logs(self) -> None:
        fixture = os.environ.get("SHIBUMI_HEALTH_LOG_FILE")
        try:
            if fixture:
                raw = Path(fixture).read_text(encoding="utf-8", errors="replace")
            elif len(self.production_pids) == 1:
                result = run(
                    [
                        "qs",
                        "log",
                        "--pid",
                        str(self.production_pids[0]),
                        "--tail",
                        "400",
                        "--no-color",
                        "--log-times",
                    ],
                    timeout=5,
                )
                if result.returncode != 0:
                    raw_detail = (result.stderr or result.stdout).strip()
                    if raw_detail and not SENSITIVE_PATTERNS.search(raw_detail):
                        detail = self.redact_home_paths(
                            safe_text(raw_detail, 280)
                        )
                    else:
                        detail = f"qs log exited with {result.returncode}"
                    self.add(
                        "runtime-errors",
                        "Runtime",
                        "Recent runtime errors",
                        "warning",
                        "Log unavailable",
                        detail,
                        "current Quickshell configuration",
                    )
                    return
                raw = result.stdout
            else:
                raw = ""
            lines = raw.splitlines()
            for index in range(len(lines) - 1, -1, -1):
                if "Configuration Loaded" in lines[index]:
                    lines = lines[index + 1 :]
                    break
            matches = []
            for line in lines:
                if not ERROR_PATTERNS.search(line) or SENSITIVE_PATTERNS.search(line):
                    continue
                line = self.redact_home_paths(line)
                matches.append(safe_text(line, 280))
            matches = matches[-8:]
            self.add(
                "runtime-errors",
                "Runtime",
                "Recent runtime errors",
                "error" if matches else "ok",
                f"{len(matches)} relevant error(s)" if matches else "None detected",
                " | ".join(matches) if matches
                else "No recent Shibumi loader, type, reference, binding-loop, or provider failure was found.",
                "current Quickshell configuration",
                "Copy the bounded detail and inspect the affected component."
                if matches else "",
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            self.add(
                "runtime-errors",
                "Runtime",
                "Recent runtime errors",
                "warning",
                "Log unavailable",
                str(error),
                "current Quickshell configuration",
            )

    def source_root(self) -> Path:
        override = os.environ.get("SHIBUMI_HEALTH_SOURCE_ROOT")
        recorded = self.state.get("sourceRoot")
        return Path(override or recorded or self.home / "Projects/shibumi")

    def install_origin(self) -> str:
        if not self.state:
            return "unknown"
        return str(self.state.get("installOrigin") or "checkout")

    def git(self, root: Path, arguments: list[str], timeout: float = 5) -> str:
        result = run(["git", "-C", str(root), *arguments], timeout=timeout)
        if result.returncode != 0:
            raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "git failed")
        return result.stdout.strip()

    def check_source(self) -> None:
        root = self.source_root()
        if not (root / ".git").exists():
            self.add(
                "source-status",
                "Source",
                "Development checkout",
                "warning",
                "Metadata unavailable",
                "The recorded development source is not a Git checkout.",
                root,
                "Use a real checkout so branch and upstream state are verifiable.",
            )
            return
        fetch_detail = ""
        try:
            branch = self.git(root, ["branch", "--show-current"])
            commit = self.git(root, ["rev-parse", "HEAD"])
            upstream_name = self.git(root, ["rev-parse", "--abbrev-ref", "@{upstream}"])
            if self.fetch:
                if "/" not in upstream_name:
                    raise RuntimeError("configured upstream has no remote")
                remote, remote_branch = upstream_name.split("/", 1)
                try:
                    self.git(
                        root,
                        [
                            "fetch",
                            "--no-tags",
                            "--quiet",
                            remote,
                            f"refs/heads/{remote_branch}:refs/remotes/{upstream_name}",
                        ],
                        timeout=configured_timeout(
                            "SHIBUMI_HEALTH_FETCH_TIMEOUT", 12
                        ),
                    )
                    fetch_detail = "Remote refs refreshed."
                    self.add(
                        "source-update",
                        "Source",
                        "Update check",
                        "ok",
                        "Completed",
                        fetch_detail,
                        root,
                    )
                except (RuntimeError, subprocess.TimeoutExpired) as error:
                    self.add(
                        "source-update",
                        "Source",
                        "Update check",
                        "warning",
                        "Check failed",
                        safe_text(str(error).splitlines()[-1], 280),
                        root,
                        "Grant this machine read access to the private remote, then retry.",
                    )
            upstream = self.git(root, ["rev-parse", "@{upstream}"])
            dirty_lines = self.git(
                root, ["status", "--porcelain=v1", "--untracked-files=normal"]
            ).splitlines()
            counts = self.git(
                root, ["rev-list", "--left-right", "--count", "HEAD...@{upstream}"]
            ).split()
            ahead, behind = (int(counts[0]), int(counts[1]))
            relation = "Current"
            status = "ok"
            if ahead and behind:
                relation, status = "Diverged", "error"
            elif behind:
                relation, status = "Update available", "warning"
            elif ahead:
                relation, status = f"Ahead {ahead}", "warning"
            elif dirty_lines:
                status = "warning"
            detail = (
                f"{branch} · {commit[:10]} · upstream {upstream[:10]} · "
                f"ahead {ahead}, behind {behind}. {fetch_detail}"
            ).strip()
            self.add(
                "source-status",
                "Source",
                "Development checkout",
                status,
                f"{relation} · {'dirty' if dirty_lines else 'clean'}",
                detail,
                root,
                "Review local changes before updating." if dirty_lines or ahead or behind else "",
            )
            if not self.fetch:
                self.add(
                    "source-update",
                    "Source",
                    "Update check",
                    "info",
                    "Not checked",
                    "Remote refs were not contacted during this local health run.",
                    root,
                    "Use Check for updates for a manual read-only fetch.",
                )
        except (RuntimeError, ValueError, subprocess.TimeoutExpired) as error:
            self.add(
                "source-status",
                "Source",
                "Development checkout",
                "warning",
                "Check failed",
                safe_text(str(error).splitlines()[-1], 280),
                root,
                "Confirm the branch has a configured upstream.",
            )

    def package_fixture(self) -> dict[str, Any] | None:
        path = os.environ.get("SHIBUMI_HEALTH_PACKAGE_FILE")
        return read_json(Path(path)) if path else None

    def installed_package_version(
        self, fixture: dict[str, Any] | None
    ) -> str:
        if fixture is not None:
            value = fixture.get("installedVersion")
            return str(value).strip() if isinstance(value, str) else ""
        result = run(["pacman", "-Q", PACKAGE_NAME], timeout=3)
        if result.returncode != 0:
            return ""
        fields = result.stdout.strip().split(maxsplit=1)
        return fields[1] if len(fields) == 2 and fields[0] == PACKAGE_NAME else ""

    @staticmethod
    def package_payload_version(value: str) -> str:
        return value.rsplit("-", 1)[0] if "-" in value else value

    @staticmethod
    def arch_payload_version(value: str) -> str:
        return value.replace("-", "")

    @staticmethod
    def compare_arch_versions(installed: str, available: str) -> int | None:
        try:
            result = run(["vercmp", available, installed], timeout=3)
        except (OSError, subprocess.TimeoutExpired):
            return 0 if available == installed else None
        if result.returncode != 0:
            return 0 if available == installed else None
        try:
            return int(result.stdout.strip())
        except ValueError:
            return 0 if available == installed else None

    def available_package_version(
        self, fixture: dict[str, Any] | None
    ) -> str | None:
        if fixture is not None:
            error = fixture.get("fetchError")
            if isinstance(error, str) and error.strip():
                raise RuntimeError(error.strip())
            value = fixture.get("availableVersion")
            return str(value).strip() if isinstance(value, str) and value.strip() else None
        timeout = configured_timeout("SHIBUMI_HEALTH_AUR_TIMEOUT", 8)
        result = run(
            [
                "curl",
                "-fsSL",
                "--max-time",
                str(timeout),
                AUR_INFO_URL,
            ],
            timeout=timeout + 1,
        )
        if result.returncode != 0:
            raise RuntimeError(
                result.stderr.strip() or result.stdout.strip() or "AUR RPC failed"
            )
        response = json.loads(result.stdout)
        if (
            not isinstance(response, dict)
            or response.get("type") not in ("multiinfo", "info")
            or not isinstance(response.get("results"), list)
        ):
            raise ValueError("AUR RPC returned an unsupported response")
        for item in response["results"]:
            if isinstance(item, dict) and item.get("Name") == PACKAGE_NAME:
                version = item.get("Version")
                if isinstance(version, str) and version.strip():
                    return version.strip()
        return None

    def check_package(self) -> None:
        fixture: dict[str, Any] | None = None
        try:
            fixture = self.package_fixture()
            installed = self.installed_package_version(fixture)
        except (
            OSError,
            ValueError,
            json.JSONDecodeError,
            subprocess.TimeoutExpired,
        ) as error:
            self.add(
                "package-status",
                "Package",
                "Arch package",
                "error",
                "Check failed",
                str(error),
                PACKAGE_NAME,
                "Confirm that pacman can read the local package database.",
            )
            return

        staged = str(self.state.get("packageVersion") or "")
        expected = self.arch_payload_version(staged)
        installed_payload = self.package_payload_version(installed)
        if not installed:
            self.add(
                "package-status",
                "Package",
                "Arch package",
                "error",
                "Not installed",
                "User plugins are staged from a package that pacman no longer owns.",
                PACKAGE_NAME,
                "Reinstall shibumi-shell, then run shibumi-shell repair --yes.",
            )
        elif installed_payload != expected:
            self.add(
                "package-status",
                "Package",
                "Package staging",
                "warning",
                f"{installed} installed · {staged} staged",
                "The system package and the user-staged plugin suite differ.",
                self.state_dir / "install.json",
                "Run shibumi-shell update --yes; add --allow-downgrade only "
                "after intentionally installing an older package.",
            )
        else:
            self.add(
                "package-status",
                "Package",
                "Arch package",
                "ok",
                installed,
                f"The staged suite matches package payload {staged}.",
                PACKAGE_NAME,
            )

        if not self.fetch:
            self.add(
                "package-update",
                "Package",
                "AUR update check",
                "info",
                "Not checked",
                "The AUR was not contacted during this local health run.",
                PACKAGE_NAME,
                "Use Check for updates to query the AUR manually.",
            )
            return
        try:
            available = self.available_package_version(fixture)
            if available is None:
                self.add(
                    "package-update",
                    "Package",
                    "AUR update check",
                    "info",
                    "Not published",
                    "No shibumi-shell package is currently registered in the AUR.",
                    PACKAGE_NAME,
                )
                return
            comparison = self.compare_arch_versions(installed, available)
            if not installed:
                status, value = "warning", f"AUR {available} available"
            elif comparison is not None and comparison > 0:
                status, value = "warning", f"Update available · {available}"
            elif comparison is not None and comparison < 0:
                status, value = "info", f"Installed newer · {available}"
            elif comparison == 0:
                status, value = "ok", f"Current · {available}"
            else:
                status, value = "warning", f"Version differs · {available}"
            self.add(
                "package-update",
                "Package",
                "AUR update check",
                status,
                value,
                f"Installed package: {installed or 'none'}.",
                PACKAGE_NAME,
                "Use Omarchy's package update flow, then run shibumi-shell update --yes."
                if status == "warning" else "",
            )
        except (
            OSError,
            RuntimeError,
            ValueError,
            json.JSONDecodeError,
            subprocess.TimeoutExpired,
        ) as error:
            self.add(
                "package-update",
                "Package",
                "AUR update check",
                "warning",
                "Check failed",
                safe_text(str(error).splitlines()[-1], 280),
                PACKAGE_NAME,
                "Check the network connection and retry manually.",
            )

    def check_versions(self) -> None:
        values = []
        for package in ("omarchy-dev", "quickshell-git"):
            try:
                result = run(["pacman", "-Q", package], timeout=3)
                if result.returncode == 0:
                    fields = result.stdout.strip().split(maxsplit=1)
                    if len(fields) == 2:
                        values.append(fields[1])
            except (OSError, subprocess.TimeoutExpired):
                pass
        suite = safe_text(self.state.get("suiteVersion") or "unknown", 40)
        detail = "Omarchy · Quickshell" if len(values) == 2 else "Package metadata is partial."
        self.add(
            "versions",
            "Metadata",
            "Versions",
            "info",
            " · ".join([suite, *values]) if values else suite,
            detail,
            self.state_dir / "install.json",
        )

    def result(self) -> dict[str, Any]:
        self.load_state_and_config()
        self.load_registry()
        self.load_processes()
        outputs = self.load_outputs()
        self.check_bar_and_outputs(outputs)
        self.check_processes()
        self.check_plugins()
        self.check_lifecycle()
        self.check_logs()
        if self.install_origin() == "package":
            self.check_package()
        elif self.install_origin() == "checkout":
            self.check_source()
        self.check_versions()
        self.checks.sort(key=lambda item: (STATUS_ORDER[item.status], item.group, item.label))
        errors = sum(check.status == "error" for check in self.checks)
        warnings = sum(check.status == "warning" for check in self.checks)
        passed = sum(check.status == "ok" for check in self.checks)
        overall = "error" if errors else "warning" if warnings else "healthy"
        if errors:
            summary = f"{errors} error(s), {warnings} warning(s)"
        elif warnings:
            summary = f"{warnings} warning(s), {passed} checks passed"
        else:
            summary = f"All {passed} checks passed"
        return {
            "schemaVersion": 1,
            "generatedEpoch": int(time.time()),
            "overall": overall,
            "summary": summary,
            "fetchRequested": self.fetch,
            "installOrigin": self.install_origin(),
            "suiteVersion": str(self.state.get("suiteVersion") or "unknown"),
            "packageName": str(self.state.get("packageName") or ""),
            "packageVersion": str(self.state.get("packageVersion") or ""),
            "checks": [asdict(check) for check in self.checks],
        }


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="shibumi-health")
    result.add_argument(
        "--fetch",
        action="store_true",
        help="check the applicable Git upstream or AUR package for updates",
    )
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        payload = Probe(fetch=args.fetch).result()
    except Exception as error:  # A health surface must fail as structured data.
        payload = {
            "schemaVersion": 1,
            "generatedEpoch": int(time.time()),
            "overall": "error",
            "summary": "Health runner failed",
            "fetchRequested": args.fetch,
            "installOrigin": "unknown",
            "suiteVersion": "unknown",
            "packageName": "",
            "packageVersion": "",
            "checks": [
                asdict(
                    Check(
                        "health-runner",
                        "Runtime",
                        "Health runner",
                        "error",
                        "Failed",
                        safe_text(error, 500),
                    )
                )
            ],
        }
    print(json.dumps(payload, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
