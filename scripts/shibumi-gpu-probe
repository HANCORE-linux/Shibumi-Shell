#!/usr/bin/env bash

set -uo pipefail
shopt -s extglob nullglob

details=${1:-0}
[[ $details == 1 ]] || details=0
sys_root=${SHIBUMI_GPU_SYS_ROOT:-/sys}
proc_root=${SHIBUMI_GPU_PROC_ROOT:-/proc}

clean_field() {
  local value=${1:-}
  value=${value//$'\n'/ }
  value=${value//$'\r'/ }
  value=${value//|/ }
  value=${value##+([[:space:]])}
  value=${value%%+([[:space:]])}
  printf '%s' "$value"
}

integer_field() {
  local value=${1:-}
  if [[ $value =~ ^[[:space:]]*([0-9]+)[[:space:]]*$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi
  return 1
}

probe_nvidia() {
  [[ ${SHIBUMI_GPU_DISABLE_NVIDIA:-0} != 1 ]] || return 1

  local nvidia_bin
  nvidia_bin=$(command -v nvidia-smi 2>/dev/null) || return 1

  local summary name version util temp used total
  IFS= read -r summary < <(
    "$nvidia_bin" \
      --query-gpu=name,driver_version,utilization.gpu,temperature.gpu,memory.used,memory.total \
      --format=csv,noheader,nounits 2>/dev/null
  ) || return 1
  IFS=, read -r name version util temp used total <<<"$summary"
  util=$(integer_field "$util") || return 1
  temp=$(integer_field "$temp") || return 1
  used=$(integer_field "$used") || return 1
  total=$(integer_field "$total") || return 1
  name=$(clean_field "$name")
  version=$(clean_field "$version")

  printf 'nvidia|%s|%s|%s|%s\n' "$util" "$temp" "$used" "$total"
  printf 'meta|%s|nvidia|%s\n' "$name" "$version"
  [[ $details == 1 ]] || return 0

  local gpu_id pid _type sm mem enc dec jpg ofa fb _ccpm command_name _extra
  local metric parsed percent memory previous_percent
  local -a process_order=()
  declare -A process_seen=()
  declare -A process_percent=()
  declare -A process_memory=()
  declare -A process_name=()
  while read -r gpu_id pid _type sm mem enc dec jpg ofa fb _ccpm \
      command_name _extra; do
    [[ $gpu_id == 0 && $pid =~ ^[0-9]+$ ]] || continue
    if [[ ${process_seen[$pid]:-0} != 1 ]]; then
      process_seen[$pid]=1
      process_order+=("$pid")
      process_percent[$pid]=-1
    fi

    # NVIDIA uses '-' when a single pmon sample cannot attribute engine load
    # to a process. Keep that state unknown and aggregate the highest real
    # value across two samples; treating '-' as 0 would fabricate idle load.
    percent=-1
    for metric in "$sm" "$mem" "$enc" "$dec" "$jpg" "$ofa"; do
      parsed=$(integer_field "$metric") || continue
      (( parsed > percent )) && percent=$parsed
    done
    previous_percent=${process_percent[$pid]}
    (( percent > previous_percent )) && process_percent[$pid]=$percent
    memory=$(integer_field "$fb") || memory=0
    (( memory >= ${process_memory[$pid]:-0} )) && process_memory[$pid]=$memory
    command_name=$(clean_field "${command_name:-GPU process}")
    [[ -n $command_name ]] || command_name="GPU process"
    process_name[$pid]=$command_name
  done < <("$nvidia_bin" pmon -d 1 -c 2 -s um 2>/dev/null)

  for pid in "${process_order[@]}"; do
    printf 'proc|%s|%s|%s|%s\n' \
      "$pid" "${process_percent[$pid]}" "${process_memory[$pid]:-0}" \
      "${process_name[$pid]:-GPU process}"
  done
  return 0
}

emit_drm_processes() {
  local slot=$1
  local driver=$2
  local info relative pid key value compact number client_key name
  local fd_driver pdev client engine memory_kib
  declare -A seen=()
  declare -A ticks=()
  declare -A memory=()
  declare -A pids=()

  for info in "$proc_root"/[0-9]*/fdinfo/*; do
    [[ -r $info ]] || continue
    relative=${info#"$proc_root"/}
    pid=${relative%%/*}
    [[ $pid =~ ^[0-9]+$ ]] || continue
    fd_driver=""
    pdev=""
    client=""
    engine=0
    memory_kib=0
    while IFS=: read -r key value; do
      compact=${value//[[:space:]]/}
      case $key in
        drm-driver)
          fd_driver=$compact
          ;;
        drm-pdev)
          pdev=$compact
          ;;
        drm-client-id)
          client=$compact
          ;;
        drm-engine-*)
          number=${value//[^0-9]/}
          [[ -n $number ]] && engine=$((engine + number))
          ;;
        drm-memory-*)
          number=${value//[^0-9]/}
          [[ -n $number ]] && memory_kib=$((memory_kib + number))
          ;;
      esac
    done <"$info"

    [[ $pdev == "$slot" || (-z $pdev && $fd_driver == "$driver") ]] \
      || continue
    (( engine > 0 || memory_kib > 0 )) || continue
    client_key="$pid:${client:-$info}"
    [[ ${seen[$client_key]:-0} != 1 ]] || continue
    seen[$client_key]=1
    ticks[$pid]=$(( ${ticks[$pid]:-0} + engine ))
    memory[$pid]=$(( ${memory[$pid]:-0} + memory_kib ))
    pids[$pid]=1
  done

  for pid in "${!pids[@]}"; do
    name=""
    [[ -r $proc_root/$pid/comm ]] && IFS= read -r name <"$proc_root/$pid/comm"
    name=$(clean_field "$name")
    [[ -n $name ]] || name="PID $pid"
    printf 'counter|%s|%s|%s|%s\n' \
      "$pid" "${ticks[$pid]:-0}" \
      "$(( (${memory[$pid]:-0} + 1023) / 1024 ))" "$name"
  done
}

probe_drm() {
  local device resolved slot driver_path driver util temp raw sensor
  local total_bytes used_bytes total_mib used_mib model model_line lspci_bin
  local version

  for device in "$sys_root"/class/drm/card+([0-9])/device; do
    [[ -d $device ]] || continue
    resolved=$(readlink -f "$device" 2>/dev/null) || continue
    slot=${resolved##*/}
    driver_path=$(readlink -f "$device/driver" 2>/dev/null) || continue
    driver=${driver_path##*/}

    util=0
    if [[ -r $device/gpu_busy_percent ]]; then
      IFS= read -r raw <"$device/gpu_busy_percent"
      util=$(integer_field "$raw") || util=0
    fi
    (( util > 100 )) && util=100

    temp=0
    for sensor in "$device"/hwmon/hwmon*/temp1_input; do
      [[ -r $sensor ]] || continue
      IFS= read -r raw <"$sensor"
      raw=$(integer_field "$raw") || continue
      temp=$((raw / 1000))
      break
    done

    used_mib=0
    total_mib=0
    if [[ -r $device/mem_info_vram_used ]]; then
      IFS= read -r used_bytes <"$device/mem_info_vram_used"
      used_bytes=$(integer_field "$used_bytes") || used_bytes=0
      used_mib=$((used_bytes / 1048576))
    fi
    if [[ -r $device/mem_info_vram_total ]]; then
      IFS= read -r total_bytes <"$device/mem_info_vram_total"
      total_bytes=$(integer_field "$total_bytes") || total_bytes=0
      total_mib=$((total_bytes / 1048576))
    fi

    model=""
    lspci_bin=$(command -v lspci 2>/dev/null || true)
    if [[ -n $lspci_bin ]]; then
      IFS= read -r model_line < <("$lspci_bin" -D -s "$slot" 2>/dev/null)
      model_line=${model_line#* }
      [[ $model_line == *": "* ]] && model=${model_line#*: }
    fi
    model=$(clean_field "$model")
    [[ -n $model ]] || model="$driver GPU"

    version=""
    [[ -r $sys_root/module/$driver/version ]] \
      && IFS= read -r version <"$sys_root/module/$driver/version"
    version=$(clean_field "$version")

    printf 'sysfs|%s|%s|%s|%s\n' \
      "$util" "$temp" "$used_mib" "$total_mib"
    printf 'meta|%s|%s|%s\n' "$model" "$driver" "$version"
    [[ $details == 1 ]] && emit_drm_processes "$slot" "$driver"
    return 0
  done
  return 1
}

if probe_nvidia; then
  printf 'status|ok\n'
  exit 0
fi
if probe_drm; then
  printf 'status|ok\n'
  exit 0
fi
printf 'none|0|0|0|0\n'
printf 'status|ok\n'
