#!/usr/bin/env bash
set -euo pipefail

version=${1:-}
semver='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-([0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*))?(\+([0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*))?$'
if [[ -z $version || ! $version =~ $semver ]]; then
  echo "release-channel-flag: invalid SemVer: ${version:-<empty>}" >&2
  exit 2
fi

prerelease=${BASH_REMATCH[5]:-}
if [[ -n $prerelease ]]; then
  IFS=. read -r -a identifiers <<<"$prerelease"
  for identifier in "${identifiers[@]}"; do
    if [[ $identifier =~ ^[0-9]+$ && $identifier == 0[0-9]* ]]; then
      echo "release-channel-flag: invalid numeric prerelease identifier: $identifier" >&2
      exit 2
    fi
  done
  printf '%s\n' --prerelease
else
  printf '%s\n' --latest
fi
