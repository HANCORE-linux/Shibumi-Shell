GATE_REDACTED_LOG_MAX_BYTES = 8 * 1024 * 1024
TOTAL_REDACTED_LOG_MAX_BYTES = 64 * 1024 * 1024
LOG_READ_CHUNK_BYTES = 64 * 1024
INVENTORY_ENTRY_MAX = 100_000
INVENTORY_FILE_MAX_BYTES = 64 * 1024 * 1024
INVENTORY_TOTAL_MAX_BYTES = 512 * 1024 * 1024
