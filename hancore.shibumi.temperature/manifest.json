{
  "schemaVersion": 1,
  "id": "hancore.shibumi.temperature",
  "name": "Shibumi Temperature",
  "version": "0.1.1-beta.8",
  "author": "HANCORE",
  "license": "MIT",
  "description": "Demand-driven hardware temperature widget and sensor panel.",
  "kinds": ["bar-widget"],
