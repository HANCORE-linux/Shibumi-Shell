{
  "schemaVersion": 1,
  "id": "hancore.shibumi.menu",
  "name": "Shibumi App Menu",
  "version": "0.1.0",
  "author": "HANCORE",
  "license": "MIT",
  "description": "Shibumi application and Omarchy command menu.",
  "kinds": [
    "menu",
    "service"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "menu": "Menu.qml",
    "service": "AppMenuService.qml"
  },
  "x-shibumi": {
    "suiteId": "hancore.shibumi",
    "bundle": "core",
    "role": "app-menu",
    "requires": [
      "hancore.shibumi.state"
    ],
    "recommends": [
      "hancore.shibumi.control-center"
    ]
  }
}
