{
  "schemaVersion": 1,
  "id": "hancore.shibumi.bar",
  "name": "Shibumi Bar",
  "version": "0.1.0",
  "author": "HANCORE",
  "license": "MIT",
  "description": "A native Shibumi full-bar plugin for Omarchy Shell.",
  "kinds": [
    "bar",
    "menu",
    "bar-widget",
    "service"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "bar": "Bar.qml",
    "menu": "menu/Menu.qml",
    "barWidget": "menu/BarWidget.qml",
    "service": "menu/AppMenuService.qml"
  },
  "barWidget": {
    "displayName": "Shibumi menu",
    "description": "Opens the Shibumi application and command menu",
    "category": "Compositor",
    "allowMultiple": false
  }
}
