#!/usr/bin/env bash

set -euo pipefail

omarchy_path=${1:-}
shift || true
timeout_seconds=${SHIBUMI_AI_UPDATE_TIMEOUT:-300}
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
compat_bin="$script_dir/compat-bin"
child_pid=""
watchdog_pid=""
unset SHIBUMI_AI_REAL_CODEX

fail() {
  printf 'shibumi-ai agents update: %s\n' "$*" >&2
  exit 1
}

[[ $omarchy_path == /* ]] || fail "OMARCHY_PATH must be absolute"
if [[ ! $timeout_seconds =~ ^[1-9][0-9]*$ ]] \
    || (( timeout_seconds > 300 )); then
  fail "SHIBUMI_AI_UPDATE_TIMEOUT must be 1..300 seconds"
fi
command -v setsid >/dev/null 2>&1 || fail "setsid is required"
updater="$omarchy_path/bin/omarchy-agent-usage-update"
if [[ ! -x $updater ]]; then
  printf 'shibumi-ai agents backend unavailable\n' >&2
  exit 66
fi

cleanup_process_group() {
  local group=${1:-}
  [[ -n $group ]] || return 0
  if kill -0 -- "-$group" 2>/dev/null; then
    kill -TERM -- "-$group" 2>/dev/null || true
    for _ in {1..30}; do
      kill -0 -- "-$group" 2>/dev/null || break
      sleep 0.1
    done
  fi
  if kill -0 -- "-$group" 2>/dev/null; then
    kill -KILL -- "-$group" 2>/dev/null || true
    for _ in {1..30}; do
      kill -0 -- "-$group" 2>/dev/null || break
      sleep 0.1
    done
  fi
}

cleanup_group() {
  cleanup_process_group "$child_pid"
}

stop_watchdog() {
  [[ -n $watchdog_pid ]] || return 0
  kill -TERM "$watchdog_pid" 2>/dev/null || true
  wait "$watchdog_pid" 2>/dev/null || true
  watchdog_pid=""
}

# shellcheck disable=SC2329 # Invoked by the EXIT trap below.
cleanup_all() {
  cleanup_group
  stop_watchdog
}

# If the QML Process is killed before its TERM trap can finish, this short-lived
# sibling observes the vanished wrapper, drains the updater process group, and
# exits. It exists only for the duration of one bounded update.
# shellcheck disable=SC2329 # Started in a subshell below.
watch_parent() {
  local parent=$1 group=$2
  trap - EXIT INT TERM HUP
  while kill -0 "$parent" 2>/dev/null; do sleep 0.1; done
  cleanup_process_group "$group"
}

# shellcheck disable=SC2329 # Invoked by the signal trap below.
finish_signal() {
  trap - EXIT INT TERM HUP
  cleanup_all
  exit 143
}
trap finish_signal INT TERM HUP
trap cleanup_all EXIT

if [[ -s ${HOME:?}/.local/share/opencode/opencode.db ]]; then
  printf '{"opencode":true}\n'
else
  printf '{"opencode":false}\n'
fi

if [[ ${1:-} == --probe-only ]]; then
  exit 0
fi

codex_requested=false
codex_excluded=false
agent_id_count=0
forwarded=()
flags=()
user_collectors=()
while (( $# )); do
  argument=$1; shift
  except=false
  case $argument in
    --force | --limits-only)
      forwarded+=("$argument"); flags+=("$argument"); continue ;;
    --except) except=true; argument=${1:-}; shift || true ;;
    --*) fail "unsupported agent updater option: $argument" ;;
  esac
  [[ $argument =~ ^[a-z0-9][a-z0-9._-]*$ ]] \
    || fail "invalid agent id: $argument"
  collector_name="omarchy-agent-usage-$argument"
  collector="$omarchy_path/bin/$collector_name"
  user_collector="${HOME:?}/.local/bin/$collector_name"
  # Extra profiles (for example claude-personal) ship their own collector.
  if [[ ! -x $collector && -x $user_collector ]]; then
    $except || user_collectors+=("$argument" "$user_collector")
    continue
  fi
  if $except; then
    [[ -x $collector ]] || continue
    forwarded+=(--except "$argument")
    [[ $argument != codex ]] || codex_excluded=true
    continue
  fi
  [[ -x $collector ]] || fail "agent collector is missing: $collector"
  forwarded+=("$argument")
  agent_id_count=$((agent_id_count + 1))
  [[ $argument != codex ]] || codex_requested=true
done
run_host_updater=true
(( agent_id_count > 0 || ${#user_collectors[@]} == 0 )) || run_host_updater=false
if $run_host_updater && (( agent_id_count == 0 )) \
    && [[ -x $omarchy_path/bin/omarchy-agent-usage-codex ]]; then
  codex_requested=true
fi

compat_environment=()
if $codex_requested && ! $codex_excluded; then
  codex_search_path=${PATH:-/usr/bin:/bin}
  for candidate_dir in \
      "${HOME:?}/.local/bin" \
      "$HOME/.npm-global/bin" \
      "$HOME/.local/share/mise/shims"; do
    case :$codex_search_path: in
      *:"$candidate_dir":*) ;;
      *) codex_search_path+=":$candidate_dir" ;;
    esac
  done
  real_codex=$(PATH="$codex_search_path" type -P codex 2>/dev/null || true)
  if [[ $real_codex == /* && -x $real_codex \
      && ! $real_codex -ef "$compat_bin/codex" ]]; then
    compat_environment+=(
      "PATH=$compat_bin:$codex_search_path"
      "SHIBUMI_AI_REAL_CODEX=$real_codex"
    )
  fi
fi

background=()
if command -v taskset >/dev/null 2>&1; then
  cpu_list=$(python3 -c 'import os; cpus = sorted(os.sched_getaffinity(0)); print(",".join(map(str, cpus[-max(2, len(cpus) // 4):])) if len(cpus) > 2 else "")' 2>/dev/null || true)
  [[ -z $cpu_list ]] || background=(nice -n 19 taskset -c "$cpu_list")
fi

host_command=()
! $run_host_updater || host_command=("$updater" "${forwarded[@]}")
setsid "${background[@]}" env OMARCHY_PATH="$omarchy_path" \
  "${compat_environment[@]}" bash -c '
    flag_count=$1; shift
    flags=("${@:1:flag_count}"); shift "$flag_count"
    user_count=$1; shift
    status=0
    usage_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage
    for (( index = 1; index < user_count; index += 2 )); do
      agent=${!index}
      next=$((index + 1))
      collector=${!next}
      record=$("$collector" "${flags[@]}") || { status=1; continue; }
      # Collectors either save their own record or print it like the host ones.
      [[ -n $record ]] || continue
      jq -e "type == \"object\"" >/dev/null 2>&1 <<<"$record" \
        || { status=1; continue; }
      mkdir -p "$usage_dir"
      tmp=$(mktemp "$usage_dir/.$agent.XXXXXX")
      printf "%s\n" "$record" >"$tmp" && mv "$tmp" "$usage_dir/$agent.json"
    done
    shift "$user_count"
    if (( $# )); then "$@" || status=1; fi
    exit "$status"
  ' agents-update "${#flags[@]}" "${flags[@]}" \
  "${#user_collectors[@]}" "${user_collectors[@]}" "${host_command[@]}" &
child_pid=$!
watch_parent "$$" "$child_pid" &
watchdog_pid=$!
deadline=$(( SECONDS + timeout_seconds ))
while kill -0 "$child_pid" 2>/dev/null; do
  if (( SECONDS >= deadline )); then
    cleanup_group
    wait "$child_pid" 2>/dev/null || true
    child_pid=""
    stop_watchdog
    fail "agent updater exceeded ${timeout_seconds}s"
  fi
  sleep 0.1
done

set +e
wait "$child_pid"
rc=$?
set -e
cleanup_group
child_pid=""
stop_watchdog
exit "$rc"
