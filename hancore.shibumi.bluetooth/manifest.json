{
  "schemaVersion": 1,
  "id": "hancore.shibumi.bluetooth",
  "name": "Shibumi Bluetooth",
  "version": "0.1.1-beta.8",
  "author": "HANCORE",
  "license": "MIT",
  "description": "Shibumi Bluetooth presentation with a native BlueZ and audio backend.",
  "kinds": ["bar-widget", "service"],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "Shibumi Bluetooth",
    "description": "Bluetooth radio, discovery, pairing, and devices",
    "category": "Hardware",
    "defaultSection": "right",
    "allowMultiple": false
  },
  "x-shibumi": {
    "suiteId": "hancore.shibumi",
    "bundle": "default",
    "role": "G15",
    "capabilities": ["bluetooth"],
    "preferredRegion": "right",
    "requires": [],
    "recommends": []
  }
}
