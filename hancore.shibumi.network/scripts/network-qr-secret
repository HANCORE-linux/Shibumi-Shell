#!/usr/bin/python3
"""Read one saved PSK for an explicitly requested connected Wi-Fi QR code."""

from __future__ import annotations

import ctypes
import json
import os
import re
import resource
import signal
import sys
from collections.abc import Mapping, Sequence
from typing import Any

import dbus

SERVICE = "org.freedesktop.NetworkManager"
ROOT_PATH = "/org/freedesktop/NetworkManager"
ROOT_INTERFACE = "org.freedesktop.NetworkManager"
DBUS_SERVICE = "org.freedesktop.DBus"
DBUS_PATH = "/org/freedesktop/DBus"
DBUS_INTERFACE = "org.freedesktop.DBus"
PROPERTIES_INTERFACE = "org.freedesktop.DBus.Properties"
DEVICE_INTERFACE = "org.freedesktop.NetworkManager.Device"
WIRELESS_INTERFACE = "org.freedesktop.NetworkManager.Device.Wireless"
ACCESS_POINT_INTERFACE = "org.freedesktop.NetworkManager.AccessPoint"
ACTIVE_INTERFACE = "org.freedesktop.NetworkManager.Connection.Active"
CONNECTION_INTERFACE = "org.freedesktop.NetworkManager.Settings.Connection"
OWNER_PATTERN = re.compile(r"^:[0-9]+\.[0-9]+$")
DEVICE_PATH = re.compile(r"^/org/freedesktop/NetworkManager/Devices/[0-9]+$")
ACTIVE_PATH = re.compile(r"^/org/freedesktop/NetworkManager/ActiveConnection/[0-9]+$")
PROFILE_PATH = re.compile(r"^/org/freedesktop/NetworkManager/Settings/[0-9]+$")
AP_PATH = re.compile(r"^/org/freedesktop/NetworkManager/AccessPoint/[0-9]+$")
UUID_PATTERN = re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
)
ENTITY_PATTERN = re.compile(r"^shibumi-network-v1:.{1,1000}$")
INTERFACE_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,14}$")
MAC_PATTERN = re.compile(r"^(?:[0-9A-F]{2}:){5}[0-9A-F]{2}$")
SSID_HEX_PATTERN = re.compile(r"^[0-9A-F]{2}(?:[0-9A-F]{2}){0,31}$")
TOKEN_PATTERN = re.compile(
    r"^shibumi-qr-secret-v1:\[[1-9][0-9]{0,9},[1-9][0-9]{0,9}\]$"
)
MAX_INPUT_BYTES = 4096
MAX_OUTPUT_BYTES = 2048
MAX_DEVICES = 64
MAX_SETTINGS_BYTES = 256 * 1024
MAX_SETTINGS_ENTRIES = 2048
MAX_ADDRESS_SPACE_BYTES = 128 * 1024 * 1024
MAX_SAFE_INTEGER = 9007199254740991
PR_SET_PDEATHSIG = 1


class SecretError(RuntimeError):
    pass


class DuplicateKeyError(SecretError):
    pass


def no_duplicate_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise DuplicateKeyError("duplicate JSON key")
        result[key] = value
    return result


def exact(value: Any, keys: set[str]) -> bool:
    return isinstance(value, dict) and set(value) == keys


def parse_request(raw: bytes) -> dict[str, Any]:
    if not 2 <= len(raw) <= MAX_INPUT_BYTES or not raw.endswith(b"\n") \
            or raw.count(b"\n") != 1:
        raise SecretError("invalid input framing")
    try:
        text = raw[:-1].decode("utf-8", errors="strict")
        value = json.loads(text, object_pairs_hook=no_duplicate_object)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise SecretError("invalid input JSON") from error
    if json.dumps(value, ensure_ascii=False, separators=(",", ":")) != text \
            or not exact(value, {
                "schemaVersion", "requestToken", "networkId", "profileUuid",
                "deviceId", "interfaceName", "hardwareAddress", "ssidHex",
                "security", "generation"
            }):
        raise SecretError("noncanonical request")
    expected_device_id = "shibumi-network-v1:" + json.dumps(
        ["device", "wifi", "mac", value.get("hardwareAddress", "")],
        ensure_ascii=False, separators=(",", ":")
    )
    if value["schemaVersion"] != 1 \
            or not isinstance(value["requestToken"], str) \
            or not TOKEN_PATTERN.fullmatch(value["requestToken"]) \
            or not isinstance(value["networkId"], str) \
            or not ENTITY_PATTERN.fullmatch(value["networkId"]) \
            or not isinstance(value["profileUuid"], str) \
            or not UUID_PATTERN.fullmatch(value["profileUuid"]) \
            or not isinstance(value["deviceId"], str) \
            or not ENTITY_PATTERN.fullmatch(value["deviceId"]) \
            or not isinstance(value["interfaceName"], str) \
            or not INTERFACE_PATTERN.fullmatch(value["interfaceName"]) \
            or not isinstance(value["hardwareAddress"], str) \
            or not MAC_PATTERN.fullmatch(value["hardwareAddress"]) \
            or value["hardwareAddress"] in {
                "00:00:00:00:00:00", "FF:FF:FF:FF:FF:FF"
            } \
            or value["deviceId"] != expected_device_id \
            or not isinstance(value["ssidHex"], str) \
            or not SSID_HEX_PATTERN.fullmatch(value["ssidHex"]) \
            or value["security"] not in {"wpa-psk", "wpa2-psk", "sae"} \
            or not isinstance(value["generation"], int) \
            or isinstance(value["generation"], bool) \
            or not 0 <= value["generation"] <= MAX_SAFE_INTEGER:
        raise SecretError("invalid request identity")
    return value


def arm_parent_death(parent_pid: int) -> None:
    soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    target = MAX_ADDRESS_SPACE_BYTES
    if soft != resource.RLIM_INFINITY:
        target = min(target, soft)
    if hard != resource.RLIM_INFINITY:
        target = min(target, hard)
    resource.setrlimit(resource.RLIMIT_AS, (target, hard))
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(PR_SET_PDEATHSIG, signal.SIGTERM, 0, 0, 0) != 0:
        os._exit(127)
    if os.getppid() != parent_pid:
        os.kill(os.getpid(), signal.SIGTERM)


def interface(bus: dbus.SystemBus, destination: str,
              path: str, name: str) -> Any:
    return dbus.Interface(bus.get_object(destination, path), name)


def prop(bus: dbus.SystemBus, destination: str,
         path: str, name: str, key: str) -> Any:
    return interface(bus, destination, path, PROPERTIES_INTERFACE).Get(name, key)


def owner(bus: dbus.SystemBus) -> str:
    value = str(interface(
        bus, DBUS_SERVICE, DBUS_PATH, DBUS_INTERFACE
    ).GetNameOwner(SERVICE))
    if not OWNER_PATTERN.fullmatch(value):
        raise SecretError("invalid NetworkManager owner")
    return value


def owner_unchanged(bus: dbus.SystemBus, expected: str) -> None:
    if owner(bus) != expected:
        raise SecretError("NetworkManager owner changed")


def device_path(bus: dbus.SystemBus, destination: str,
                request: dict[str, Any]) -> str:
    values = list(interface(
        bus, destination, ROOT_PATH, ROOT_INTERFACE
    ).GetDevices())
    if len(values) > MAX_DEVICES:
        raise SecretError("device list exceeded bound")
    matches: list[str] = []
    for raw in values:
        path = str(raw)
        if not DEVICE_PATH.fullmatch(path):
            raise SecretError("invalid device path")
        if int(prop(bus, destination, path, DEVICE_INTERFACE, "DeviceType")) != 2:
            continue
        name = str(prop(bus, destination, path, DEVICE_INTERFACE, "Interface"))
        address = str(prop(
            bus, destination, path, DEVICE_INTERFACE, "HwAddress"
        )).upper()
        if name == request["interfaceName"] \
                and address == request["hardwareAddress"] \
                and bool(prop(bus, destination, path, DEVICE_INTERFACE, "Managed")):
            matches.append(path)
    if len(matches) != 1:
        raise SecretError("device identity is ambiguous")
    return matches[0]


def active_identity(bus: dbus.SystemBus, destination: str,
                    request: dict[str, Any], device: str) -> tuple[str, str, str]:
    active = str(prop(
        bus, destination, device, DEVICE_INTERFACE, "ActiveConnection"
    ))
    if not ACTIVE_PATH.fullmatch(active) \
            or int(prop(bus, destination, active, ACTIVE_INTERFACE, "State")) != 2 \
            or str(prop(bus, destination, active, ACTIVE_INTERFACE, "Uuid")).lower() \
                != request["profileUuid"]:
        raise SecretError("active connection identity mismatch")
    devices = [str(value) for value in prop(
        bus, destination, active, ACTIVE_INTERFACE, "Devices"
    )]
    if devices != [device]:
        raise SecretError("active connection device mismatch")
    profile = str(prop(
        bus, destination, active, ACTIVE_INTERFACE, "Connection"
    ))
    if not PROFILE_PATH.fullmatch(profile) \
            or str(prop(bus, destination, profile,
                        CONNECTION_INTERFACE, "Uuid")).lower() \
                != request["profileUuid"] \
            or str(prop(bus, destination, profile,
                        CONNECTION_INTERFACE, "Type")) != "802-11-wireless" \
            or bool(prop(bus, destination, profile,
                         CONNECTION_INTERFACE, "Unsaved")):
        raise SecretError("active profile identity mismatch")
    ap = str(prop(
        bus, destination, device, WIRELESS_INTERFACE, "ActiveAccessPoint"
    ))
    if not AP_PATH.fullmatch(ap):
        raise SecretError("active access point identity mismatch")
    raw_ssid = bytes(prop(
        bus, destination, ap, ACCESS_POINT_INTERFACE, "Ssid"
    ))
    if not 1 <= len(raw_ssid) <= 32 \
            or raw_ssid.hex().upper() != request["ssidHex"]:
        raise SecretError("active SSID identity mismatch")
    try:
        ssid = raw_ssid.decode("utf-8", errors="strict")
    except UnicodeDecodeError as error:
        raise SecretError("active SSID encoding is invalid") from error
    expected_network_id = "shibumi-network-v1:" + json.dumps(
        ["network", request["deviceId"], ssid, request["security"]],
        ensure_ascii=False, separators=(",", ":")
    )
    if request["networkId"] != expected_network_id:
        raise SecretError("active network entity mismatch")
    return active, profile, ap


def bounded_settings_size(value: Any, depth: int = 0) -> tuple[int, int]:
    if depth > 5:
        raise SecretError("settings nesting exceeded bound")
    if isinstance(value, (str, dbus.String, dbus.ObjectPath, dbus.Signature)):
        return len(str(value).encode("utf-8", errors="strict")), 1
    if isinstance(value, (bytes, bytearray, dbus.ByteArray)):
        return len(bytes(value)), 1
    if isinstance(value, (bool, int, float, dbus.Boolean,
                          dbus.Int16, dbus.Int32, dbus.Int64,
                          dbus.UInt16, dbus.UInt32, dbus.UInt64,
                          dbus.Byte, dbus.Double)):
        return 16, 1
    if isinstance(value, Mapping):
        total = 0
        entries = 1
        for key, item in value.items():
            if not isinstance(key, (str, dbus.String)):
                raise SecretError("settings key has invalid type")
            key_size = len(str(key).encode("utf-8", errors="strict"))
            item_size, item_entries = bounded_settings_size(item, depth + 1)
            total += key_size + item_size
            entries += 1 + item_entries
            if total > MAX_SETTINGS_BYTES or entries > MAX_SETTINGS_ENTRIES:
                raise SecretError("settings map exceeded bound")
        return total, entries
    if isinstance(value, Sequence):
        total = 0
        entries = 1
        for item in value:
            item_size, item_entries = bounded_settings_size(item, depth + 1)
            total += item_size
            entries += item_entries
            if total > MAX_SETTINGS_BYTES or entries > MAX_SETTINGS_ENTRIES:
                raise SecretError("settings sequence exceeded bound")
        return total, entries
    raise SecretError("settings value has invalid type")


def setting_group(settings: Any, name: str) -> Mapping[Any, Any]:
    if not isinstance(settings, Mapping):
        raise SecretError("settings response has invalid type")
    value = settings.get(name)
    if not isinstance(value, Mapping):
        raise SecretError("required settings group is missing")
    return value


def profile_snapshot(bus: dbus.SystemBus, destination: str, profile: str,
                     request: dict[str, Any]) -> tuple[int, str, str]:
    settings = interface(
        bus, destination, profile, CONNECTION_INTERFACE
    ).GetSettings()
    size, entries = bounded_settings_size(settings)
    if size > MAX_SETTINGS_BYTES or entries > MAX_SETTINGS_ENTRIES:
        raise SecretError("settings response exceeded bound")
    connection = setting_group(settings, "connection")
    wireless = setting_group(settings, "802-11-wireless")
    security = setting_group(settings, "802-11-wireless-security")
    if str(connection.get("uuid", "")).lower() != request["profileUuid"] \
            or str(connection.get("type", "")) != "802-11-wireless":
        raise SecretError("profile settings identity mismatch")
    raw_ssid = bytes(wireless.get("ssid", b""))
    if not 1 <= len(raw_ssid) <= 32 \
            or raw_ssid.hex().upper() != request["ssidHex"]:
        raise SecretError("profile settings SSID mismatch")
    key_management = str(security.get("key-mgmt", ""))
    raw_protocols = security.get("proto", [])
    if not isinstance(raw_protocols, Sequence) \
            or isinstance(raw_protocols, (str, bytes, bytearray)) \
            or len(raw_protocols) > 8:
        raise SecretError("profile protocol setting is invalid")
    protocols = [str(value) for value in raw_protocols]
    if any(value not in {"wpa", "rsn"} for value in protocols):
        raise SecretError("profile protocol setting is invalid")
    mixed_wpa_rsn = "wpa" in protocols and "rsn" in protocols
    if key_management == "wpa-psk":
        token = "wpa-psk" if mixed_wpa_rsn else "wpa2-psk"
    elif key_management == "sae":
        token = "sae"
    else:
        raise SecretError("profile security is not shareable")
    if token != request["security"]:
        raise SecretError("profile security identity mismatch")
    version = int(prop(
        bus, destination, profile, CONNECTION_INTERFACE, "VersionId"
    ))
    if not 0 <= version <= MAX_SAFE_INTEGER:
        raise SecretError("profile version is invalid")
    return version, raw_ssid.hex().upper(), token


def valid_psk(value: Any, security: str) -> str:
    if not isinstance(value, (str, dbus.String)):
        raise SecretError("saved PSK has invalid type")
    result = str(value)
    try:
        length = len(result.encode("utf-8", errors="strict"))
    except UnicodeEncodeError as error:
        raise SecretError("saved PSK has invalid encoding") from error
    if "\x00" in result or "\r" in result or "\n" in result:
        raise SecretError("saved PSK contains forbidden controls")
    if security == "sae":
        if not 1 <= length <= 63:
            raise SecretError("saved SAE credential is invalid")
    elif not (re.fullmatch(r"[0-9A-Fa-f]{64}", result)
              or 8 <= length <= 63):
        raise SecretError("saved PSK is invalid")
    return result


def extract_psk(secrets: Any, security: str) -> str:
    if not isinstance(secrets, (dict, dbus.Dictionary)) \
            or set(str(key) for key in secrets) != {"802-11-wireless-security"}:
        raise SecretError("unexpected secret setting map")
    setting = secrets.get("802-11-wireless-security")
    if not isinstance(setting, (dict, dbus.Dictionary)) \
            or set(str(key) for key in setting) != {"psk"}:
        raise SecretError("unexpected secret field map")
    return valid_psk(setting["psk"], security)


def run(request: dict[str, Any]) -> dict[str, Any]:
    arm_parent_death(os.getppid())
    bus = dbus.SystemBus()
    destination = owner(bus)
    device = device_path(bus, destination, request)
    before = active_identity(bus, destination, request, device)
    settings_before = profile_snapshot(
        bus, destination, before[1], request
    )
    secrets = interface(
        bus, destination, before[1], CONNECTION_INTERFACE
    ).GetSecrets("802-11-wireless-security")
    psk = extract_psk(secrets, request["security"])
    owner_unchanged(bus, destination)
    after = active_identity(bus, destination, request, device)
    settings_after = profile_snapshot(
        bus, destination, after[1], request
    )
    owner_unchanged(bus, destination)
    if after != before or settings_after != settings_before:
        raise SecretError("active profile changed during secret read")
    return {
        "schemaVersion": 1,
        "status": "completed",
        "requestToken": request["requestToken"],
        "networkId": request["networkId"],
        "profileUuid": request["profileUuid"],
        "deviceId": request["deviceId"],
        "interfaceName": request["interfaceName"],
        "hardwareAddress": request["hardwareAddress"],
        "ssidHex": request["ssidHex"],
        "security": request["security"],
        "generation": request["generation"],
        "psk": psk,
    }


def main() -> int:
    try:
        request = parse_request(sys.stdin.buffer.read(MAX_INPUT_BYTES + 1))
        result = run(request)
        output = json.dumps(result, ensure_ascii=False, separators=(",", ":"))
        encoded = output.encode("utf-8", errors="strict")
        if len(encoded) > MAX_OUTPUT_BYTES or b"\n" in encoded:
            raise SecretError("output exceeded bound")
        sys.stdout.buffer.write(encoded + b"\n")
        sys.stdout.buffer.flush()
        result["psk"] = ""
        output = ""
        return 0
    except (SecretError, DuplicateKeyError, dbus.DBusException, OSError):
        print("network-qr-secret: unavailable", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
