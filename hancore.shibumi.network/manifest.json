{
  "schemaVersion": 1,
  "id": "hancore.shibumi.network",
  "name": "Shibumi Network",
  "version": "0.1.1-beta.8",
  "author": "HANCORE",
  "license": "MIT",
  "description": "Shibumi network presentation over Omarchy's NetworkManager owner.",
  "kinds": ["bar-widget", "service"],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "Shibumi network",
    "description": "Network status, Wi-Fi profiles, DNS, and speed test",
    "category": "Network",
    "defaultSection": "right",
    "allowMultiple": false
  },
  "x-shibumi": {
    "suiteId": "hancore.shibumi",
    "bundle": "default",
    "role": "G11",
    "capabilities": ["network"],
    "preferredRegion": "right",
    "requires": [],
    "recommends": []
  }
}
